---
import SectionHead from './SectionHead.astro';
import GitHubIcon from './GitHubIcon.astro';
import { REPO_URL, SCHEMA_PATH } from './links';

const rules = [
  { title: 'Closed objects', text: 'Every object sets additionalProperties to false.' },
  { title: 'Every key required', text: 'Optional values are present and null, never missing.' },
  { title: 'Nullable as anyOf', text: 'A nullable field is anyOf its type and null.' },
  { title: 'Enums for ids', text: 'Dates, slot labels and spot ids are enums from the trip data.' },
];
---

<section id="developers" aria-labelledby="developers-title" class="scroll-mt-4 border-b border-line">
  <div class="mx-auto grid max-w-6xl gap-12 px-4 py-16 sm:px-6 sm:py-20 lg:grid-cols-[1fr_1.05fr] lg:items-start">
    <div class="min-w-0">
      <SectionHead id="developers-title" kicker="For developers" title="A published schema for structured output">
        <p>
          The plan format is a JSON Schema served at <a href={SCHEMA_PATH} class="t-accent font-mono text-[15px] font-medium underline underline-offset-2">{SCHEMA_PATH}</a>.
          It keeps to the subset that the structured-output modes of the major AI APIs accept, so the same file works as the
          response format for any of them.
        </p>
        <p>
          With the API target, the prompt leaves the schema out and you pass it to your provider's structured-output option.
          With the Chat target, the schema travels inside the prompt.
        </p>
      </SectionHead>
      <dl class="mt-10 grid gap-5 sm:grid-cols-2">
        {
          rules.map((r) => (
            <div class="border-t border-line pt-4">
              <dt class="text-[15px] font-bold">{r.title}</dt>
              <dd class="mt-1 ml-0 text-[14.5px] leading-relaxed text-muted">{r.text}</dd>
            </div>
          ))
        }
      </dl>
      <p class="mt-10 mb-0 text-[15px] leading-relaxed text-muted">
        PhotoRouter is open source under the MIT licence.
        <a href={REPO_URL} class="ml-1 inline-flex items-center gap-1.5 font-semibold text-ink underline underline-offset-2">
          <GitHubIcon class="size-4" />Source on GitHub
        </a>
      </p>
    </div>

    <figure class="m-0 min-w-0">
      <div class="overflow-hidden rounded-[22px] border border-line bg-surface shadow-card">
        <div class="flex items-center justify-between gap-3 border-b border-line px-4 py-3">
          <p class="m-0 font-mono text-[11px] tracking-[0.08em] text-muted uppercase">GET {SCHEMA_PATH}</p>
          <span class="inline-flex h-6 items-center rounded-full border border-line bg-surface-2 px-2.5 font-mono text-[10.5px] text-muted">
            application/schema+json
          </span>
        </div>
        <pre class="code scroll-thin m-0 overflow-x-auto p-4 text-ink" tabindex="0" aria-label="Excerpt of the plan schema">{'{'}
  <span class="k">"type"</span>: <span class="s">"object"</span>,
  <span class="k">"additionalProperties"</span>: <span class="n">false</span>,
  <span class="k">"required"</span>: [
    <span class="s">"version"</span>, <span class="s">"summary"</span>, <span class="s">"days"</span>, <span class="s">"skipped"</span>
  ],
  <span class="k">"properties"</span>: {'{'}
    <span class="k">"version"</span>: {'{'}
      <span class="k">"type"</span>: <span class="s">"string"</span>,
      <span class="k">"const"</span>: <span class="s">"photorouter.plan/v1"</span>
    {'}'},
    <span class="k">"days"</span>: {'{'}
      <span class="k">"type"</span>: <span class="s">"array"</span>,
      <span class="k">"items"</span>: {'{'}
        <span class="k">"required"</span>: [<span class="s">"date"</span>, <span class="s">"title"</span>, <span class="s">"slots"</span>],
        <span class="k">"properties"</span>: {'{'}
          <span class="k">"date"</span>: {'{'} <span class="k">"enum"</span>: [<span class="s">"2026-11-16"</span>, <span class="n">…</span>] {'}'},
          <span class="k">"title"</span>: {'{'} <span class="k">"anyOf"</span>: [
            {'{'} <span class="k">"type"</span>: <span class="s">"string"</span> {'}'},
            {'{'} <span class="k">"type"</span>: <span class="s">"null"</span> {'}'}
          ] {'}'},
          <span class="k">"slots"</span>: <span class="n">…</span>
        {'}'}
      {'}'}
    {'}'},
    <span class="k">"skipped"</span>: <span class="n">…</span>
  {'}'}
{'}'}</pre>
      </div>
      <figcaption class="mt-3 px-1 text-[13px] text-muted">An excerpt of the published schema.</figcaption>
    </figure>
  </div>
</section>
