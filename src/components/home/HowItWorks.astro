---
import SectionHead from './SectionHead.astro';
import Chip from './Chip.astro';
import { GEAR, STYLES, dayLabel, gearItem } from '@/photorouter/lib/data';
import { DEFAULT_PROMPT } from '@/photorouter/lib/prompt';
import { demoFor, loadDemo, plain } from './demoData';

const demo = demoFor('europe');
const { brief, answer } = demo;
const { plan, errors, warnings } = loadDemo(demo);

const gearOff = GEAR.find((g) => !brief.gear.includes(g.id) && g.kind !== 'body' && g.kind !== 'lens');
const gear = [
  ...brief.gear.map((id) => ({ label: plain(gearItem(id)?.short ?? id), on: true })),
  ...(gearOff ? [{ label: gearOff.short, on: false }] : []),
];
const styles = STYLES.slice(0, 7).map((s) => ({ label: s.label, on: brief.styles.includes(s.id) }));
const paces = ['relaxed', 'balanced', 'packed'] as const;

const weights = [
  { label: 'Best light', n: DEFAULT_PROMPT.priorities.light },
  { label: 'Style match', n: DEFAULT_PROMPT.priorities.style },
  { label: 'Short walks', n: DEFAULT_PROMPT.priorities.walking },
  { label: 'Quiet spots', n: DEFAULT_PROMPT.priorities.crowds },
  { label: 'Variety', n: DEFAULT_PROMPT.priorities.variety },
  { label: 'Famous views', n: DEFAULT_PROMPT.priorities.icons },
];

const firstDay = answer.days[0]!;
const firstCity = answer.cities.find((c) => c.id === firstDay.cityId)?.name;
const firstStops = firstDay.slots.map((s) => ({ label: s.label, name: answer.spots.find((p) => p.id === s.spotId)?.name }));

const cityIndex = Object.fromEntries(Object.values(plan.trip.cities).map((c) => [c.id, c.color % 6]));
const strip = plan.days.map((d) => ({ c: cityIndex[d.city] ?? 0, stops: d.slots.length }));
const shown = plan.days.findIndex((d) => !!d.leg);
const shownDay = plan.days[shown < 0 ? 0 : shown]!;
const legFrom = cityIndex[shownDay.from ?? shownDay.city] ?? 0;
const legTo = cityIndex[shownDay.city] ?? 0;

const mock = 'rt-cream flex min-h-[236px] flex-col gap-3 rounded-2xl p-4';
const label = 'm-0 font-mono text-[10.5px] tracking-[0.08em] text-muted uppercase';
const field = 'rounded-xl border border-line bg-surface px-3 py-1.5 text-xs text-ink';
---

<section id="how" aria-labelledby="how-title" class="scroll-mt-20 rt-rule">
  <div class="mx-auto max-w-6xl px-4 py-16 sm:px-6 sm:py-20">
    <SectionHead id="how-title" kicker="How it works" title="Four steps from idea to route">
      <p>
        You describe the trip, an AI chat assistant suggests the places, and PhotoRouter checks the plan and shows it on the
        map.
      </p>
    </SectionHead>

    <ol class="mt-12 grid list-none gap-5 p-0 md:grid-cols-2">
      <li class="flex flex-col rt-panel rounded-[22px] p-4 sm:p-5">
        <div class={mock} aria-hidden="true">
          <div class="grid grid-cols-[minmax(0,1fr)_auto_auto] gap-2">
            <p class={label}>Where</p>
            <p class={label}>First day</p>
            <p class={label}>Days</p>
            <span class:list={[field, 'truncate font-semibold']}>{brief.destination}</span>
            <span class={field}>{dayLabel(brief.start)} {brief.start.slice(0, 4)}</span>
            <span class={field}>{brief.days}</span>
          </div>
          <p class={label}>Gear</p>
          <div class="flex flex-wrap gap-1.5">
            {gear.map((g) => <Chip on={g.on}>{g.label}</Chip>)}
          </div>
          <p class={label}>What you like to shoot</p>
          <div class="flex flex-wrap gap-1.5">
            {styles.map((s) => <Chip on={s.on}>{s.label}</Chip>)}
          </div>
          <div class="flex flex-wrap items-center gap-2">
            <p class={label}>Pace</p>
            <span class="inline-flex rounded-full border border-line bg-surface p-0.5 text-[11.5px] font-semibold">
              {
                paces.map((p) => (
                  <span class:list={['rounded-full px-2.5 py-0.5 capitalize', p === brief.pace ? 'bg-ink text-surface' : 'text-muted']}>{p}</span>
                ))
              }
            </span>
          </div>
          <p class="m-0 mt-auto rounded-xl border border-line bg-surface px-3 py-2 text-xs leading-relaxed text-muted">
            Must-see: {brief.must.join(', ')}.<span class="blink text-ink">|</span>
          </p>
        </div>
        <div class="mt-5 flex items-baseline gap-3">
          <span class="t-accent font-display text-3xl leading-none font-extrabold">01</span>
          <h3 class="m-0 text-lg font-bold">Describe the trip</h3>
        </div>
        <p class="mt-2 mb-0 leading-relaxed text-muted">
          Where you are going (a country, a region or a few cities), when and for how many days. Add your camera gear, what you
          like to shoot, how packed the days should be, how much you want to walk, places you must see and places to skip.
        </p>
      </li>

      <li class="flex flex-col rt-panel rounded-[22px] p-4 sm:p-5">
        <div class={mock} aria-hidden="true">
          <p class={label}>What matters most</p>
          <div class="grid grid-cols-[6rem_1fr] items-center gap-x-3 gap-y-2">
            {
              weights.map((w) => (
                <>
                  <span class="text-xs font-semibold text-ink">{w.label}</span>
                  <span class="flex gap-1">
                    {[1, 2].map((i) => (
                      <span class:list={['h-2 flex-1 rounded-full', i <= w.n ? 'bg-accent' : 'bg-line']} />
                    ))}
                  </span>
                </>
              ))
            }
          </div>
          <span class="mt-auto inline-flex h-8 w-fit items-center rounded-full bg-accent px-3.5 text-xs font-semibold text-accent-ink">
            Copy the prompt
          </span>
        </div>
        <div class="mt-5 flex items-baseline gap-3">
          <span class="t-accent font-display text-3xl leading-none font-extrabold">02</span>
          <h3 class="m-0 text-lg font-bold">Get the prompt</h3>
        </div>
        <p class="mt-2 mb-0 leading-relaxed text-muted">
          Choose what matters most: the best light, short walks, quiet spots or the famous views. PhotoRouter turns your trip
          into a detailed prompt, the request you give an AI assistant, with every day of the trip and how many stops fit in
          it.
        </p>
      </li>

      <li class="flex flex-col rt-panel rounded-[22px] p-4 sm:p-5">
        <div class={mock} aria-hidden="true">
          <div class="flex flex-col gap-2 text-xs leading-relaxed">
            <p class="m-0 ml-8 rounded-2xl rounded-br-md bg-ink px-3 py-2 text-surface">
              Plan a {brief.days} day photo trip to {brief.destination}. <span class="opacity-60">…</span>
            </p>
            <div class="mr-8 rounded-2xl rounded-bl-md border border-line bg-surface px-3 py-2 text-muted">
              <p class="m-0 font-semibold text-ink">Day 1, {firstCity}</p>
              {firstStops.map((s) => <p class="m-0">{s.label}: {s.name}</p>)}
              <p class="m-0 opacity-60">…</p>
            </div>
          </div>
          <div class="mt-auto flex flex-wrap items-center gap-2 border-t border-line pt-3 text-xs font-semibold">
            <span class="inline-flex h-6 items-center gap-1.5 rounded-full border border-line bg-surface px-2.5 text-ink">
              <span class="size-2 rounded-full bg-sz"></span>Plan loaded
            </span>
            <span class="inline-flex h-6 items-center gap-1.5 rounded-full border border-line bg-surface px-2.5 text-ink">
              {errors.length} {errors.length === 1 ? 'problem' : 'problems'}
            </span>
            <span class="lt-day inline-flex h-6 items-center gap-1.5 rounded-full border border-line bg-surface px-2.5 text-ink">
              <span class="size-2 rounded-full bg-(--c)"></span>{warnings.length} {warnings.length === 1 ? 'note' : 'notes'}
            </span>
          </div>
        </div>
        <div class="mt-5 flex items-baseline gap-3">
          <span class="t-accent font-display text-3xl leading-none font-extrabold">03</span>
          <h3 class="m-0 text-lg font-bold">Ask your AI assistant</h3>
        </div>
        <p class="mt-2 mb-0 leading-relaxed text-muted">
          Paste the prompt into the AI chat assistant you use. It picks the cities, the photo spots, the trains, flights or
          ferries between them and a spot for each part of each day. Copy its reply back into PhotoRouter, which checks it
          against your trip and tells you what to fix if something is off.
        </p>
      </li>

      <li class="flex flex-col rt-panel rounded-[22px] p-4 sm:p-5">
        <div class={mock} aria-hidden="true">
          <svg viewBox="0 0 300 92" class="block h-auto w-full">
            <path d="M14 70 C 70 66, 90 30, 150 34 S 240 18, 286 22" fill="none" stroke="var(--line)" stroke-width="10" stroke-linecap="round"></path>
            <path d="M14 70 C 70 66, 90 30, 150 34 S 240 18, 286 22" fill="none" stroke="var(--ink)" stroke-width="3" stroke-linecap="round"></path>
            <path d="M14 70 C 70 66, 90 30, 150 34 S 240 18, 286 22" pathLength="1000" class="train" fill="none" stroke="var(--accent)" stroke-width="8" stroke-linecap="round"></path>
            <circle cx="14" cy="70" r="6" class={`c-${legFrom}`} fill="var(--surface)" stroke="var(--c)" stroke-width="3"></circle>
            <circle cx="286" cy="22" r="6" class={`c-${legTo}`} fill="var(--surface)" stroke="var(--c)" stroke-width="3"></circle>
          </svg>
          <div class="flex items-center gap-3">
            <span class="grid size-8 shrink-0 place-items-center rounded-full bg-accent text-accent-ink">
              <svg viewBox="0 0 16 16" class="size-3.5"><path d="M5 3.5v9l7.5-4.5Z" fill="currentColor"></path></svg>
            </span>
            <span class="flex min-w-0 flex-1 gap-[3px]">
              {
                strip.map((d, i) => (
                  <span class:list={[`c-${d.c}`, 'h-5 flex-1 rounded-[4px] bg-(--c)', i === shownDay.index ? 'outline-2 outline-offset-1 outline-ink' : 'opacity-60']} />
                ))
              }
            </span>
          </div>
          <p class="m-0 font-mono text-[11px] tracking-[0.06em] text-muted uppercase">
            {dayLabel(shownDay.date)} · {plan.trip.cities[shownDay.city]?.name} · {shownDay.slots.length} stops
          </p>
        </div>
        <div class="mt-5 flex items-baseline gap-3">
          <span class="t-accent font-display text-3xl leading-none font-extrabold">04</span>
          <h3 class="m-0 text-lg font-bold">Follow the route</h3>
        </div>
        <p class="mt-2 mb-0 leading-relaxed text-muted">
          The plan opens on a 3D map you can play day by day, following each train or flight and walking from stop to stop.
          Each day lists when the light is best at every stop, what to pack and the local name to show a driver.
        </p>
      </li>
    </ol>
  </div>
</section>
