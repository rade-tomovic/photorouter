---
import Logo from './Logo.astro';
import GitHubIcon from './GitHubIcon.astro';
import { APP_PATH, REPO_URL } from './links';
---

<header class="border-b border-line">
  <div class="mx-auto flex h-16 max-w-6xl items-center gap-3 px-4 sm:px-6">
    <a href="/" class="flex items-center gap-2.5 rounded-full text-ink no-underline">
      <Logo class="size-8" />
      <span class="font-display text-[23px] leading-none font-extrabold tracking-wide uppercase">PhotoRouter</span>
    </a>
    <nav aria-label="Sections" class="ml-6 hidden items-center gap-5 text-sm text-muted lg:flex">
      <a href="#how" class="no-underline hover:text-ink">How it works</a>
      <a href="#map" class="no-underline hover:text-ink">On the map</a>
      <a href="#demos" class="no-underline hover:text-ink">Example trips</a>
      <a href="#privacy" class="no-underline hover:text-ink">Privacy</a>
    </nav>
    <div class="ml-auto flex items-center gap-2">
      <a
        href={REPO_URL}
        class="inline-flex size-9 items-center justify-center gap-1.5 rounded-full border border-line bg-surface-2 text-[13px] font-semibold text-ink no-underline hover:border-muted sm:w-auto sm:px-3.5"
      >
        <GitHubIcon class="size-4" />
        <span class="sr-only sm:not-sr-only">GitHub</span>
      </a>
      <a
        href={APP_PATH}
        class="inline-flex h-9 items-center rounded-full bg-accent px-3.5 text-[13px] font-semibold whitespace-nowrap text-accent-ink no-underline hover:brightness-110"
      >
        <span class="min-[400px]:hidden">Planner</span>
        <span class="hidden min-[400px]:inline">Open the planner</span>
      </a>
    </div>
  </div>
</header>
