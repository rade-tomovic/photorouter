---
// The PhotoRouter mark: an aperture whose blades are route segments.
interface Props {
  class?: string;
}
const { class: className = 'size-8' } = Astro.props;
---

<svg viewBox="0 0 32 32" class={className} aria-hidden="true" focusable="false">
  <circle cx="16" cy="16" r="14" fill="var(--accent)"></circle>
  <path d="M16 6.5 24.2 11v10L16 25.5 7.8 21V11Z" fill="none" stroke="var(--accent-ink)" stroke-width="2" stroke-linejoin="round"></path>
  <path d="M16 6.5v9.5l8.2 5M16 16l-8.2 5" fill="none" stroke="var(--accent-ink)" stroke-width="2" stroke-linecap="round"></path>
  <circle cx="16" cy="16" r="2.4" fill="var(--accent-ink)"></circle>
</svg>
