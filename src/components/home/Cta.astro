---
import { APP_PATH } from './links';
import { DEMOS, countWord } from './demoData';
---

<section aria-labelledby="cta-title">
  <div class="mx-auto max-w-6xl px-4 py-16 sm:px-6 sm:py-20">
    <div class="rt-panel flex flex-col items-start gap-6 rounded-[28px] p-6 sm:p-10 md:flex-row md:items-center md:justify-between">
      <div class="max-w-[36rem]">
        <h2 id="cta-title" class="m-0 font-display text-[clamp(32px,5vw,48px)] leading-[0.95] font-extrabold uppercase">
          Try it with an example trip
        </h2>
        <p class="mt-3 mb-0 text-[16.5px] leading-relaxed text-muted">
          {countWord(DEMOS.length)} ready-made trips, one per continent, open straight away. Or describe your own trip and
          plan it with the AI assistant you already use.
        </p>
      </div>
      <a
        href={APP_PATH}
        class="rt-btn inline-flex h-12 shrink-0 items-center gap-2 rounded-full px-6 text-[15px] font-semibold no-underline"
      >
        Open the planner
        <svg viewBox="0 0 16 16" class="size-4" aria-hidden="true" focusable="false">
          <path d="M3 8h9M8.5 4 12.5 8l-4 4" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"></path>
        </svg>
      </a>
    </div>
  </div>
</section>
