---
interface Props {
  id: string;
  kicker: string;
  title: string;
}
const { id, kicker, title } = Astro.props;
---

<div class="max-w-[46rem]">
  <p class="rt-plate m-0 font-mono text-[11px] tracking-[0.16em] uppercase">{kicker}</p>
  <h2 id={id} class="rt-engrave mt-4 mb-0 font-display text-[clamp(34px,5.4vw,56px)] leading-[0.95] font-extrabold tracking-[0.01em] text-balance uppercase">
    {title}
  </h2>
  <div class="mt-5 text-[16.5px] leading-relaxed text-muted [&_p]:m-0 [&_p+p]:mt-3">
    <slot />
  </div>
</div>
