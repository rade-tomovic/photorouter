---
import SectionHead from './SectionHead.astro';

const points = [
  { title: 'No account', text: 'Nothing to sign up for. Open the planner and start.' },
  { title: 'No backend', text: 'The brief, the prompt, the validator and the map all run in the browser.' },
  {
    title: 'No built-in agent',
    text: 'You choose the AI. The prompt and the answer leave the browser only when you copy them there.',
  },
  {
    title: 'Map tiles only',
    text: 'Map tiles are the only network requests the planner makes. The demo trips ship with the page, and the default one comes from the time zone setting, not a location lookup.',
  },
];
const inBrowser = ['Brief', 'Prompt', 'Validator', 'Map', 'Day sheets', 'Demo trips'];
---

<section id="privacy" aria-labelledby="privacy-title" class="scroll-mt-4 border-b border-line bg-surface-2/40">
  <div class="mx-auto grid max-w-6xl gap-12 px-4 py-16 sm:px-6 sm:py-20 lg:grid-cols-[1fr_1.1fr] lg:items-center">
    <div class="min-w-0">
      <SectionHead id="privacy-title" kicker="Privacy" title="Runs in your browser">
        <p>The planner is a set of static files. Once loaded, it does its work in the browser tab.</p>
      </SectionHead>
      <dl class="mt-10 grid gap-5 sm:grid-cols-2">
        {
          points.map((p) => (
            <div class="border-t border-line pt-4">
              <dt class="text-[15px] font-bold">{p.title}</dt>
              <dd class="mt-1 ml-0 text-[14.5px] leading-relaxed text-muted">{p.text}</dd>
            </div>
          ))
        }
      </dl>
    </div>

    <figure class="m-0 min-w-0">
      <div class="grid gap-3 sm:grid-cols-[1fr_auto_minmax(0,11rem)] sm:items-center">
        <div class="rounded-[22px] border-2 border-dashed border-line bg-surface p-4 sm:p-5">
          <p class="m-0 font-mono text-[11px] tracking-[0.08em] text-muted uppercase">Your browser</p>
          <ul class="m-0 mt-4 grid list-none grid-cols-2 gap-2 p-0">
            {
              inBrowser.map((b) => (
                <li class="rounded-xl border border-line bg-surface-2 px-3 py-3 text-sm font-semibold">{b}</li>
              ))
            }
          </ul>
        </div>

        <div class="flex items-center justify-center gap-2 py-1 sm:flex-col" aria-hidden="true">
          <svg viewBox="0 0 48 24" class="w-12 rotate-90 sm:rotate-0" focusable="false">
            <path d="M4 8h36m-6-5 6 5-6 5" fill="none" stroke="var(--accent)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path>
          </svg>
          <svg viewBox="0 0 48 24" class="w-12 rotate-90 sm:rotate-0" focusable="false">
            <path d="M44 16H8m6-5-6 5 6 5" fill="none" stroke="var(--ink)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path>
          </svg>
        </div>

        <div class="rounded-[22px] border border-line bg-surface p-4 sm:p-5">
          <p class="m-0 font-mono text-[11px] tracking-[0.08em] text-muted uppercase">Your own AI</p>
          <p class="mt-3 mb-0 text-sm leading-snug">
            <span class="t-accent font-semibold">You copy the prompt</span> into a chat assistant or an API call.
          </p>
          <p class="mt-2 mb-0 text-sm leading-snug"><span class="font-semibold">You paste the JSON</span> back.</p>
        </div>
      </div>
      <figcaption class="mt-3 px-1 text-[13px] text-muted">
        What crosses the browser boundary: the prompt and the answer, by your hand, and map tiles.
      </figcaption>
    </figure>
  </div>
</section>
