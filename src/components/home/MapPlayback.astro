---
import SectionHead from './SectionHead.astro';
import DaySheet from './DaySheet.astro';
import { daySheet, demoFor } from './demoData';

const features = [
  {
    title: '3D map',
    text: 'Buildings and hills in 3D, in a detailed or a clean style, light or dark.',
  },
  { title: 'Timeline', text: 'Jump to any day, or play the whole trip from arrival to departure.' },
  {
    title: 'Day sheets',
    text: 'When the light is best at each stop, worked out from local sunrise and sunset, what to pack and the local name to show a driver.',
  },
  {
    title: 'Spot cards',
    text: 'Every spot opens a card with its best light, a tip, the local name to copy and a link to open it on a map.',
  },
];

const demo = demoFor('europe');
const sheet = daySheet(demo, 1);
---

<section id="map" aria-labelledby="map-title" class="scroll-mt-20 border-b border-line">
  <div class="mx-auto max-w-6xl px-4 py-16 sm:px-6 sm:py-20">
    <div class="grid gap-12 lg:grid-cols-[1fr_1fr] lg:items-start">
      <div class="min-w-0">
        <SectionHead id="map-title" kicker="On the map" title="Watch your trip before you go">
          <p>
            Your plan becomes a route you can watch. The camera travels the way you will, and each day opens a sheet with what
            to shoot, when, and with what.
          </p>
        </SectionHead>
        <dl class="mt-10 grid gap-5 sm:grid-cols-2">
          {
            features.map((f) => (
              <div class="border-t border-line pt-4">
                <dt class="text-[15px] font-bold">{f.title}</dt>
                <dd class="mt-1 ml-0 text-[14.5px] leading-relaxed text-muted">{f.text}</dd>
              </div>
            ))
          }
        </dl>
      </div>

      <figure class="m-0 min-w-0">
        <DaySheet demo={demo} index={1} />
        <figcaption class="mt-3 px-1 text-[13px] text-muted">
          Day {sheet.number} of the {demo.label} example, simplified. Times are local, from sunrise and sunset in {sheet.city} on
          {sheet.longDate}.
        </figcaption>
      </figure>
    </div>

    <h3 class="mt-16 mb-0 font-mono text-[11.5px] font-medium tracking-[0.1em] text-muted uppercase">Travelling the route</h3>
    <ul class="mt-4 grid list-none gap-4 p-0 sm:grid-cols-3">
      <li class="rounded-[22px] border border-line bg-surface p-4">
        <svg viewBox="0 0 100 60" class="block h-auto w-full rounded-xl bg-surface-2" aria-hidden="true" focusable="false">
          <path d="M8 48 C 30 46, 40 20, 62 18 S 88 12, 94 10" fill="none" stroke="var(--ink)" stroke-width="2.2" stroke-linecap="round"></path>
          <path d="M8 48 C 30 46, 40 20, 62 18 S 88 12, 94 10" fill="none" stroke="var(--surface-2)" stroke-width="1" stroke-dasharray="2.5 2.5"></path>
          <path d="M8 48 C 30 46, 40 20, 62 18 S 88 12, 94 10" pathLength="1000" class="train" fill="none" stroke="var(--accent)" stroke-width="5" stroke-linecap="round"></path>
        </svg>
        <p class="mt-3 mb-0 text-[15px] font-bold">Between cities</p>
        <p class="mt-1 mb-0 text-[14.5px] leading-relaxed text-muted">
          The camera follows each train, flight, ferry or drive from one city to the next.
        </p>
      </li>
      <li class="rounded-[22px] border border-line bg-surface p-4">
        <svg viewBox="0 0 100 60" class="block h-auto w-full rounded-xl bg-surface-2" aria-hidden="true" focusable="false">
          <path d="M14 44 L36 26 L58 38 L84 16" class="c-0 walk" fill="none" stroke="var(--c)" stroke-width="1.6" stroke-dasharray="3 4" stroke-linecap="round" stroke-linejoin="round"></path>
          <path d="M14 44 L36 26 L58 38 L84 16" pathLength="1000" class="walker-dot" fill="none" stroke="var(--accent)" stroke-width="6" stroke-linecap="round"></path>
          <circle cx="14" cy="44" r="3.6" class="lt-dawn" fill="var(--c)"></circle>
          <circle cx="36" cy="26" r="3.6" class="lt-day" fill="var(--c)"></circle>
          <circle cx="58" cy="38" r="3.6" class="lt-golden" fill="var(--c)"></circle>
          <circle cx="84" cy="16" r="3.6" class="lt-night" fill="var(--c)"></circle>
        </svg>
        <p class="mt-3 mb-0 text-[15px] font-bold">Between stops</p>
        <p class="mt-1 mb-0 text-[14.5px] leading-relaxed text-muted">A walker follows your route from one stop to the next.</p>
      </li>
      <li class="rounded-[22px] border border-line bg-surface p-4">
        <svg viewBox="0 0 100 60" class="block h-auto w-full rounded-xl bg-surface-2" aria-hidden="true" focusable="false">
          <circle cx="50" cy="30" r="22" fill="none" stroke="var(--line)" stroke-width="1.4" stroke-dasharray="3 3"></circle>
          <rect x="44" y="18" width="5" height="16" rx="1" fill="var(--route)"></rect>
          <rect x="50" y="12" width="6" height="22" rx="1" fill="var(--ink)" opacity="0.75"></rect>
          <circle cx="50" cy="36" r="3.4" class="lt-golden" fill="var(--c)"></circle>
          <g class="orbit">
            <circle cx="72" cy="30" r="4" fill="var(--accent)"></circle>
          </g>
        </svg>
        <p class="mt-3 mb-0 text-[15px] font-bold">At each stop</p>
        <p class="mt-1 mb-0 text-[14.5px] leading-relaxed text-muted">The camera flies in and circles the spot so you can see the setting.</p>
      </li>
    </ul>
  </div>
</section>
