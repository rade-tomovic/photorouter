---
import SectionHead from './SectionHead.astro';

const features = [
  {
    title: '3D map',
    text: 'MapLibre GL with OpenFreeMap vector tiles, extruded 3D buildings and optional terrain.',
  },
  { title: 'Styles and themes', text: 'Detailed and Clean map styles, each in light and dark.' },
  { title: 'Timeline', text: 'Scrub the trip day by day, or play it through from arrival to departure.' },
  {
    title: 'Day sheets',
    text: "Each stop's light window computed from sun times, the kit to pack and the Chinese name to copy for a taxi.",
  },
];

const stops = [
  {
    slot: 'Before work',
    name: 'Shamian Island',
    zh: '沙面岛',
    light: 'dawn',
    window: 'Dawn 06:18-08:15',
    kit: ['16-35 mm'],
  },
  {
    slot: 'After work',
    name: 'Pearl River night cruise',
    zh: '天字码头',
    light: 'night',
    window: 'Night 18:15-20:00',
    kit: ['16-35 mm'],
  },
];
---

<section id="map" aria-labelledby="map-title" class="scroll-mt-4 border-b border-line">
  <div class="mx-auto max-w-6xl px-4 py-16 sm:px-6 sm:py-20">
    <div class="grid gap-12 lg:grid-cols-[1fr_1fr] lg:items-start">
      <div class="min-w-0">
        <SectionHead id="map-title" kicker="Map and playback" title="Play the route on a 3D map">
          <p>
            An imported plan becomes a route you can watch. Travel animations move the camera the way you will move on the
            trip, and each day opens a sheet with what to shoot, when, and with what.
          </p>
        </SectionHead>
        <dl class="mt-10 grid gap-5 sm:grid-cols-2">
          {
            features.map((f) => (
              <div class="border-t border-line pt-4">
                <dt class="text-[15px] font-bold">{f.title}</dt>
                <dd class="mt-1 ml-0 text-[14.5px] leading-relaxed text-muted">{f.text}</dd>
              </div>
            ))
          }
        </dl>
      </div>

      <figure class="m-0 min-w-0">
        <div class="c-gz rounded-[22px] border border-line bg-surface p-4 shadow-card sm:p-5">
          <div class="flex flex-wrap items-center justify-between gap-2">
            <p class="m-0 font-mono text-[11px] tracking-[0.08em] text-muted uppercase">Day 2 · Tue 17 Nov</p>
            <span class="t-c inline-flex h-6 items-center rounded-full border border-current px-2.5 text-xs font-semibold">Guangzhou</span>
          </div>
          <p class="mt-2 mb-0 font-display text-[28px] leading-none font-extrabold uppercase">Shamian at dawn, the river by night</p>
          <ol class="m-0 mt-5 flex list-none flex-col gap-3 p-0">
            {
              stops.map((s) => (
                <li class="rounded-2xl border border-line bg-surface-2 p-3.5">
                  <div class="flex flex-wrap items-center justify-between gap-2">
                    <span class="font-mono text-[10.5px] tracking-[0.08em] text-muted uppercase">{s.slot}</span>
                    <span class={`lt-${s.light} inline-flex h-6 items-center gap-1.5 rounded-full border border-line bg-surface px-2.5 text-xs font-semibold`}>
                      <span class="size-2 rounded-full bg-(--c)" aria-hidden="true" />
                      {s.window}
                    </span>
                  </div>
                  <p class="mt-2 mb-0 text-base font-bold">{s.name}</p>
                  <div class="mt-2 flex flex-wrap items-center gap-1.5">
                    {s.kit.map((k) => (
                      <span class="inline-flex h-6 items-center rounded-full border border-line bg-surface px-2.5 text-xs font-semibold text-muted">{k}</span>
                    ))}
                    <span class="ml-auto inline-flex h-6 items-center gap-1.5 rounded-full border border-line bg-surface px-2.5 text-xs font-semibold">
                      <span class="font-zh text-[13px]" lang="zh-Hans">{s.zh}</span>
                      <span class="text-muted">Copy</span>
                    </span>
                  </div>
                </li>
              ))
            }
          </ol>
        </div>
        <figcaption class="mt-3 px-1 text-[13px] text-muted">17 November from the bundled example plan, simplified.</figcaption>
      </figure>
    </div>

    <h3 class="mt-16 mb-0 font-mono text-[11.5px] font-medium tracking-[0.1em] text-muted uppercase">Travel animations</h3>
    <ul class="mt-4 grid list-none gap-4 p-0 sm:grid-cols-3">
      <li class="rounded-[22px] border border-line bg-surface p-4">
        <svg viewBox="0 0 100 60" class="block h-auto w-full rounded-xl bg-surface-2" aria-hidden="true" focusable="false">
          <path d="M8 48 C 30 46, 40 20, 62 18 S 88 12, 94 10" fill="none" stroke="var(--ink)" stroke-width="2.2" stroke-linecap="round"></path>
          <path d="M8 48 C 30 46, 40 20, 62 18 S 88 12, 94 10" fill="none" stroke="var(--surface-2)" stroke-width="1" stroke-dasharray="2.5 2.5"></path>
          <path d="M8 48 C 30 46, 40 20, 62 18 S 88 12, 94 10" pathLength="1000" class="train" fill="none" stroke="var(--accent)" stroke-width="5" stroke-linecap="round"></path>
        </svg>
        <p class="mt-3 mb-0 text-[15px] font-bold">Chase camera</p>
        <p class="mt-1 mb-0 text-[14.5px] leading-relaxed text-muted">Follows the train along each rail leg between cities.</p>
      </li>
      <li class="rounded-[22px] border border-line bg-surface p-4">
        <svg viewBox="0 0 100 60" class="block h-auto w-full rounded-xl bg-surface-2" aria-hidden="true" focusable="false">
          <path d="M14 44 L36 26 L58 38 L84 16" class="c-gz walk" fill="none" stroke="var(--c)" stroke-width="1.6" stroke-dasharray="3 4" stroke-linecap="round" stroke-linejoin="round"></path>
          <path d="M14 44 L36 26 L58 38 L84 16" pathLength="1000" class="walker-dot" fill="none" stroke="var(--accent)" stroke-width="6" stroke-linecap="round"></path>
          <circle cx="14" cy="44" r="3.6" class="lt-dawn" fill="var(--c)"></circle>
          <circle cx="36" cy="26" r="3.6" class="lt-day" fill="var(--c)"></circle>
          <circle cx="58" cy="38" r="3.6" class="lt-golden" fill="var(--c)"></circle>
          <circle cx="84" cy="16" r="3.6" class="lt-night" fill="var(--c)"></circle>
        </svg>
        <p class="mt-3 mb-0 text-[15px] font-bold">Walker</p>
        <p class="mt-1 mb-0 text-[14.5px] leading-relaxed text-muted">Walks the route from one stop to the next within a city.</p>
      </li>
      <li class="rounded-[22px] border border-line bg-surface p-4">
        <svg viewBox="0 0 100 60" class="block h-auto w-full rounded-xl bg-surface-2" aria-hidden="true" focusable="false">
          <circle cx="50" cy="30" r="22" fill="none" stroke="var(--line)" stroke-width="1.4" stroke-dasharray="3 3"></circle>
          <rect x="44" y="18" width="5" height="16" rx="1" fill="var(--route)"></rect>
          <rect x="50" y="12" width="6" height="22" rx="1" fill="var(--ink)" opacity="0.75"></rect>
          <circle cx="50" cy="36" r="3.4" class="lt-golden" fill="var(--c)"></circle>
          <g class="orbit">
            <circle cx="72" cy="30" r="4" fill="var(--accent)"></circle>
          </g>
        </svg>
        <p class="mt-3 mb-0 text-[15px] font-bold">Arrive and orbit</p>
        <p class="mt-1 mb-0 text-[14.5px] leading-relaxed text-muted">Flies in to each stop and circles it so you can read the setting.</p>
      </li>
    </ul>
  </div>
</section>
