---
// A day as one bar coloured by its light, blended between phases. dayplay.ts dims the part
// of the day still ahead through data-rail-dim; without JavaScript the whole bar shows.
import type { SunDay } from '@/photorouter/lib/sun';
import { phases, type Phase } from './daylight';

interface Props {
  sun: SunDay;
  start: number;
  end: number;
  class?: string;
  style?: string;
}
const { sun, start, end, class: className = 'h-2', style = '' } = Astro.props;

const COLOR: Record<Phase, string> = {
  night: 'color-mix(in oklab, var(--night) 30%, var(--surface-2))',
  blue: 'var(--night)',
  golden: 'var(--golden)',
  day: 'var(--day)',
};
const pct = (m: number) => ((m - start) / (end - start)) * 100;
const blend = 1.2;
const stops = phases(sun, start, end).flatMap((p) => {
  const a = pct(p.from);
  const b = pct(p.to);
  const pad = Math.min(blend, (b - a) / 3);
  return [`${COLOR[p.phase]} ${(a + pad).toFixed(2)}%`, `${COLOR[p.phase]} ${(b - pad).toFixed(2)}%`];
});
---

<div class={`day-rail relative overflow-hidden rounded-full ${className}`} style={`${style};background:linear-gradient(to right, ${stops.join(', ')})`}>
  <span class="day-rail-dim absolute inset-y-0 right-0" style="left:100%" data-rail-dim></span>
</div>
