---
import SectionHead from './SectionHead.astro';
import MiniRoute from './MiniRoute.astro';
import { CONTINENT_LABEL, DEMOS, countWord, demoForZone, statsOf } from './demoData';
import { LIGHT_LABEL } from '@/photorouter/lib/data';
import type { Light } from '@/photorouter/lib/types';

const cards = DEMOS.map((demo, i) => ({ demo, color: `c-${i % 6}`, continent: CONTINENT_LABEL[demo.continent], stats: statsOf(demo) }));
const zone = 'America/Sao_Paulo';
const zoneDemo = demoForZone(zone);
const fallback = demoForZone('UTC');
const lights = Object.entries(LIGHT_LABEL) as [Light, string][];
---

<section id="demos" aria-labelledby="demos-title" class="scroll-mt-4 border-b border-line bg-surface-2/40">
  <div class="mx-auto max-w-6xl px-4 py-16 sm:px-6 sm:py-20">
    <SectionHead id="demos-title" kicker="Demo trips" title={`${countWord(DEMOS.length)} trips, one per continent`}>
      <p>
        Each demo is a ready-made answer: a brief and the JSON plan returned for it. It goes through the same importer as a
        pasted answer, so the map, the day sheets and playback work without running a prompt.
      </p>
      <p>
        The planner opens on the demo for your part of the world, picked from your browser's time zone with no network
        request. A time zone of {zone} opens {zoneDemo.label}; zones outside the six regions open {fallback.label}. A picker
        switches between them.
      </p>
    </SectionHead>

    <p class="mt-8 mb-0 text-[13px] text-muted">
      Spots are coloured by their best light and spread out around each city so every one stays visible.
    </p>
    <ul class="mt-3 flex list-none flex-wrap items-center gap-x-4 gap-y-2 p-0" aria-label="Spot colours by light">
      {
        lights.map(([id, text]) => (
          <li class={`lt-${id} inline-flex items-center gap-1.5 text-xs font-semibold text-ink`}>
            <span class="size-2.5 rounded-full bg-(--c)" aria-hidden="true" />
            {text}
          </li>
        ))
      }
    </ul>

    <ul class="mt-5 grid list-none gap-5 p-0 sm:grid-cols-2 lg:grid-cols-3">
      {
        cards.map(({ demo, color, continent, stats }) => (
          <li class="flex">
            <a
              href={`/app/?demo=${demo.id}`}
              class="group flex w-full flex-col rounded-[22px] border border-line bg-surface p-4 text-ink no-underline shadow-card transition-colors hover:border-muted"
            >
            <MiniRoute demo={demo} color={color} />
            <p class={`${color} mt-4 mb-0 flex items-center gap-1.5 font-mono text-[10.5px] tracking-[0.08em] text-muted uppercase`}>
              <span class="size-2 rounded-full bg-(--c)" aria-hidden="true" />
              {continent}
            </p>
            <h3 class="mt-1.5 mb-0 text-lg leading-snug font-bold group-hover:underline">{demo.label}</h3>
            <p class="mt-1 mb-4 text-[14.5px] leading-relaxed text-muted">{demo.blurb}</p>
            <p class="mt-auto mb-0 border-t border-line pt-3 font-mono text-[11px] leading-relaxed tracking-[0.04em] text-muted">
              {stats.days} days · {stats.cities} cities · {stats.spots} spots
              <span class="block">Travel: {stats.modes.join(', ').toLowerCase()}</span>
            </p>
            <span class="mt-3 inline-flex items-center gap-1 text-sm font-semibold text-accent">
              Open this trip <span aria-hidden="true">→</span>
            </span>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</section>
