---
// "Light meter": the hero day on a retro full-frame mirrorless body seen from above, drawn
// to scale in mm. The shutter dial, the top display and the lens's aperture ring follow the
// exposure for the sun's real altitude, and the lens on the mount is the one each stop's kit
// calls for, swapped when the stop changes. Without JavaScript it is a still drawing of the
// last stop; play.ts plays the day.
import { lightDay, type Demo } from '../demoData';
import { mountedLens, needsSupport, phaseAt, PHASE_LABEL } from '../daylight';
import { hhmm, tzOffset } from '@/photorouter/lib/sun';
import DayScale from './DayScale.astro';
import TopDial from './TopDial.astro';
import CameraLens from './CameraLens.astro';
import { DIAL, altitude, exposure, readingText, sceneEv, solarFor } from './meter';
import { dialTurn, polar } from './plate';
import { MOUNT_DOT, lensSize, parseLens } from './lens';
import './meter.css';

interface Props {
  demo: Demo;
  index: number;
}
const { demo, index } = Astro.props;
const { sheet, sun, stops, start, end, play } = lightDay(demo, index);
const solar = solarFor(sheet.date, sheet.ll[1], sheet.ll[0], tzOffset(sheet.date, sheet.tz));

// The still drawing shows the last stop at its planned time.
const still = stops.at(-1)!;
const m0 = still.t;
const read0 = exposure(sceneEv(altitude(m0, solar)));
const lens0 = mountedLens(still, m0) ?? '';
const phase0 = phaseAt(m0, sun);
const stop0 = stops.find((s) => m0 >= s.from && m0 <= s.to) ?? still;

// Every lens the day's kit lists, drawn once each; the view is tall enough for the longest.
const lenses = [...new Set(stops.flatMap((s) => s.kit))].flatMap((label) => {
  const spec = parseLens(label);
  return spec ? [{ label, spec, size: lensSize(spec) }] : [];
});
const CAP = 150;
const longest = Math.min(CAP, Math.max(60, ...lenses.map((l) => l.size.length)));
const widest = Math.max(66, ...lenses.map((l) => l.size.dia));

// The body is 144 mm wide; the mount face sits at Y0 and the lens hangs from it.
const W = 200;
const CX = W / 2;
const Y0 = 58.6;
const H = Math.ceil(Y0 + longest + 4);
const pct = (v: number, of: number) => `${((v / of) * 100).toFixed(2)}%`;
const side = pct(CX - widest / 2 - 4, W);

const deg = (v: number, pos: string, neg: string) => {
  const a = Math.abs(v);
  return `${Math.floor(a)}°${String(Math.round((a % 1) * 60)).padStart(2, '0')}′${v >= 0 ? pos : neg}`;
};
const coords = `${deg(sheet.ll[1], 'N', 'S')} ${deg(sheet.ll[0], 'E', 'W')}`;

const SHUTTER = DIAL.map((s, i) => ({ text: s.replace('s', '″'), at: i * 30, ...(/s|B/.test(s) ? { class: 'cam-dial-slow' } : {}) }));
const ISO = [
  { text: 'L', at: -40 },
  ...['100', '200', '400', '800', '1600', '3200', '6400'].map((text, i) => ({ text, at: i * 40 })),
  { text: 'H', at: 280 },
];
const COMP = [
  { text: '-3', at: -90 },
  { text: '-2', at: -60 },
  { text: '-1', at: -30 },
  { text: '0', at: 0, class: 'cam-dial-zero' },
  { text: '+1', at: 30 },
  { text: '+2', at: 60 },
  { text: '+3', at: 90 },
];

// Shutter release with its power lever, set to on.
const REL = { x: 40.4, y: 47.4 };
const at = (r: number, a: number) => polar(REL.x, REL.y, r, a);
const lever = [at(6, 194), at(9.4, 197), at(9.4, 203), at(6, 206)];
const on = at(11.4, 200);
const off = at(11.4, 158);
const isoLever = [polar(138.5, 28.6, 11, 128), polar(138.5, 28.6, 15.4, 131), polar(138.5, 28.6, 15.4, 139), polar(138.5, 28.6, 11, 142)];
const pts = (ps: { x: number; y: number }[]) => ps.map((p) => `${p.x.toFixed(2)},${p.y.toFixed(2)}`).join(' ');
---

<div
  class="th-meter rt-panel rounded-[22px] p-4 sm:p-5"
  data-meter
  data-phase={phase0}
  data-day={JSON.stringify(play)}
  data-solar={JSON.stringify(solar)}
>
  <div class="flex items-center justify-between gap-2">
    <p class="m-0 font-mono text-[11px] tracking-[0.08em] text-muted uppercase">
      Day {sheet.number} · {sheet.label} · <span class="tabular-nums" data-clock>{hhmm(m0)}</span>
    </p>
    <span class={`c-${sheet.cityColor} inline-flex h-6 items-center gap-1.5 rounded-full border border-line px-2.5 text-xs font-semibold`}>
      <span class="size-2 rounded-full bg-(--c)" aria-hidden="true"></span>{sheet.city}
    </span>
  </div>

  <div class="relative mt-3">
    <svg viewBox={`0 0 ${W} ${H}`} class="cam block h-auto w-full" aria-hidden="true" focusable="false">
      <defs>
        <linearGradient id="cam-plate" x1="0" x2="0" y1="0" y2="1">
          <stop offset="0" stop-color="#e6e9eb"></stop>
          <stop offset="0.1" stop-color="#cdd2d6"></stop>
          <stop offset="0.6" stop-color="#b2b8bd"></stop>
          <stop offset="1" stop-color="#8f969c"></stop>
        </linearGradient>
        <pattern id="cam-brush" width="7" height="0.7" patternUnits="userSpaceOnUse">
          <rect width="7" height="0.32" fill="#fff" opacity="0.12"></rect>
          <rect y="0.35" width="4" height="0.18" fill="#000" opacity="0.05"></rect>
        </pattern>
        <linearGradient id="cam-facet-l" x1="0" x2="1" y1="0" y2="0">
          <stop offset="0" stop-color="#f6f7f8"></stop>
          <stop offset="1" stop-color="#c9ced2"></stop>
        </linearGradient>
        <linearGradient id="cam-facet-r" x1="0" x2="1" y1="0" y2="0">
          <stop offset="0" stop-color="#9aa1a7"></stop>
          <stop offset="1" stop-color="#737a80"></stop>
        </linearGradient>
        <linearGradient id="cam-facet-f" x1="0" x2="0" y1="0" y2="1">
          <stop offset="0" stop-color="#c7ccd0"></stop>
          <stop offset="1" stop-color="#9ba2a8"></stop>
        </linearGradient>
        <linearGradient id="cam-facet-b" x1="0" x2="0" y1="0" y2="1">
          <stop offset="0" stop-color="#7f868c"></stop>
          <stop offset="1" stop-color="#aab0b5"></stop>
        </linearGradient>
        <linearGradient id="cam-chrome" x1="0" x2="0" y1="0" y2="1">
          <stop offset="0" stop-color="#f4f6f8"></stop>
          <stop offset="0.45" stop-color="#b8c0c7"></stop>
          <stop offset="0.55" stop-color="#8a939c"></stop>
          <stop offset="1" stop-color="#d9dee3"></stop>
        </linearGradient>
        <linearGradient id="cam-knurl" x1="0" x2="1" y1="0" y2="1">
          <stop offset="0" stop-color="#f2f4f6"></stop>
          <stop offset="0.5" stop-color="#a3abb2"></stop>
          <stop offset="1" stop-color="#5d666f"></stop>
        </linearGradient>
        <radialGradient id="cam-cap" cx="0.36" cy="0.3" r="0.8">
          <stop offset="0" stop-color="#ffffff"></stop>
          <stop offset="0.45" stop-color="#d3d9de"></stop>
          <stop offset="1" stop-color="#8b949c"></stop>
        </radialGradient>
        <radialGradient id="cam-black" cx="0.4" cy="0.32" r="0.8">
          <stop offset="0" stop-color="#2e353c"></stop>
          <stop offset="0.7" stop-color="#191e23"></stop>
          <stop offset="1" stop-color="#0e1114"></stop>
        </radialGradient>
        <linearGradient id="cam-lcd" x1="0" x2="1" y1="0" y2="1">
          <stop offset="0" stop-color="#1d2329"></stop>
          <stop offset="1" stop-color="#07090b"></stop>
        </linearGradient>
        <linearGradient id="cam-glare" x1="0" x2="1" y1="0" y2="1">
          <stop offset="0" stop-color="#fff" stop-opacity="0.22"></stop>
          <stop offset="0.45" stop-color="#fff" stop-opacity="0.04"></stop>
          <stop offset="1" stop-color="#fff" stop-opacity="0"></stop>
        </linearGradient>
        <linearGradient id="cam-cyl" x1="0" x2="1" y1="0" y2="0">
          <stop offset="0" stop-color="#000" stop-opacity="0.65"></stop>
          <stop offset="0.16" stop-color="#000" stop-opacity="0.1"></stop>
          <stop offset="0.34" stop-color="#fff" stop-opacity="0.13"></stop>
          <stop offset="0.5" stop-color="#fff" stop-opacity="0.02"></stop>
          <stop offset="0.8" stop-color="#000" stop-opacity="0.22"></stop>
          <stop offset="1" stop-color="#000" stop-opacity="0.72"></stop>
        </linearGradient>
        <pattern id="cam-leather" width="2" height="2" patternUnits="userSpaceOnUse">
          <rect width="2" height="2" fill="#121619"></rect>
          <circle cx="0.5" cy="0.6" r="0.42" fill="#20262b"></circle>
          <circle cx="1.5" cy="1.5" r="0.46" fill="#1b2025"></circle>
        </pattern>
        <pattern id="cam-ribs" width="1.7" height="4" patternUnits="userSpaceOnUse">
          <rect width="1.7" height="4" fill="#0b0e11"></rect>
          <rect width="0.8" height="4" fill="#2b3239"></rect>
        </pattern>
        <pattern id="cam-fine" width="0.9" height="4" patternUnits="userSpaceOnUse">
          <rect width="0.9" height="4" fill="#101418"></rect>
          <rect width="0.4" height="4" fill="#323a42"></rect>
        </pattern>
        <pattern id="cam-knurl-edge" width="0.9" height="2" patternUnits="userSpaceOnUse">
          <rect width="0.9" height="2" fill="#15191d"></rect>
          <rect width="0.4" height="2" fill="#4a535b"></rect>
        </pattern>
        <linearGradient id="cam-cast" x1="0" x2="1" y1="0" y2="0">
          <stop offset="0" stop-color="#000" stop-opacity="0.2"></stop>
          <stop offset="1" stop-color="#000" stop-opacity="0"></stop>
        </linearGradient>
        <filter id="cam-soft" x="-10%" y="-10%" width="120%" height="140%">
          <feGaussianBlur stdDeviation="1.4"></feGaussianBlur>
        </filter>
      </defs>

      <g class="cam-lenses">
        {
          lenses.map((l, i) => (
            <CameraLens label={l.label} spec={l.spec} cx={CX} y0={Y0} av={read0.av} cap={CAP} on={l.label === lens0} id={`cam-lens-${i}`} />
          ))
        }
      </g>

      <path
        d="M33 13.2H167Q172 13.2 172 18.2V50.2Q172 55.6 167 55.6H66C61 55.6 60 62 53 62H36Q28 62 28 54V18.2Q28 13.2 33 13.2Z"
        fill="#000"
        opacity="0.55"
        filter="url(#cam-soft)"
      ></path>

      <g class="cam-body">
        <rect x="31" y="10.6" width="14" height="2" rx="0.6" fill="url(#cam-knurl-edge)"></rect>
        <g class="cam-lug">
          <rect x="25.6" y="20.4" width="2.8" height="6" rx="0.8" fill="url(#cam-chrome)"></rect>
          <path d="M26.2 21.3C21.4 21.3 20.4 25.5 26.2 25.5" class="cam-ring"></path>
          <rect x="171.6" y="20.4" width="2.8" height="6" rx="0.8" fill="url(#cam-chrome)"></rect>
          <path d="M173.8 21.3C178.6 21.3 179.6 25.5 173.8 25.5" class="cam-ring"></path>
        </g>

        <path
          d="M33 12H167Q172 12 172 17V49Q172 54 167 54H66C61 54 60 60.5 53 60.5H36Q28 60.5 28 52.5V17Q28 12 33 12Z"
          fill="url(#cam-leather)"
        ></path>
        <path d="M66 54C61 54 60 60.5 53 60.5H36Q28 60.5 28 52.5" fill="none" stroke="#fff" stroke-opacity="0.08" stroke-width="0.4"></path>

        <path d="M33.5 13H166.5Q171 13 171 17.5V44.6Q171 48.6 167 48.6H66C60.5 48.6 60 59.2 52.5 59.2H36Q29 59.2 29 52V17.5Q29 13 33.5 13Z" fill="url(#cam-plate)"></path>
        <path d="M33.5 13H166.5Q171 13 171 17.5V44.6Q171 48.6 167 48.6H66C60.5 48.6 60 59.2 52.5 59.2H36Q29 59.2 29 52V17.5Q29 13 33.5 13Z" fill="url(#cam-brush)"></path>
        <path d="M34 13.5H166" stroke="#fff" stroke-opacity="0.75" stroke-width="0.5" stroke-linecap="round"></path>
        <path d="M66 48.2C60.5 48.2 60 58.8 52.5 58.8H36Q29.5 58.8 29.5 52M134 48.2H167Q170.6 48.2 170.6 44.6" fill="none" stroke="#000" stroke-opacity="0.35" stroke-width="0.5"></path>

        <rect x="86" y="3.6" width="28" height="8" rx="2.6" fill="#15191d"></rect>
        <rect x="86" y="3.6" width="28" height="8" rx="2.6" fill="url(#cam-glare)"></rect>
        <path d="M88.4 5.4H111.6M88.4 7.2H111.6" stroke="#fff" stroke-opacity="0.07" stroke-width="0.5"></path>
        <rect x="89" y="9.4" width="22" height="1.8" fill="#0b0d10"></rect>

        <polygon points="77,10.6 123,10.6 116,15 84,15" fill="url(#cam-facet-b)"></polygon>
        <polygon points="77,10.6 84,15 84,40 77,54" fill="url(#cam-facet-l)"></polygon>
        <polygon points="123,10.6 116,15 116,40 123,54" fill="url(#cam-facet-r)"></polygon>
        <polygon points="84,40 116,40 123,54 77,54" fill="url(#cam-facet-f)"></polygon>
        <rect x="123" y="13" width="5" height="35.6" fill="url(#cam-cast)"></rect>
        <rect x="84" y="15" width="32" height="25" fill="url(#cam-plate)"></rect>
        <rect x="84" y="15" width="32" height="25" fill="url(#cam-brush)"></rect>
        <path d="M77 10.6H123L116 15H84ZM84 40H116L123 54H77Z" fill="none" stroke="#000" stroke-opacity="0.18" stroke-width="0.3"></path>
        <text x="100" y="49.3" class="cam-eng cam-eng-wide" font-size="2.7">{sheet.city.toUpperCase()}</text>

        <g class="cam-shoe">
          <rect x="90" y="17.4" width="20" height="20.2" rx="0.8" fill="#20262c"></rect>
          <rect x="90" y="17.4" width="2.7" height="20.2" rx="0.5" fill="url(#cam-chrome)"></rect>
          <rect x="107.3" y="17.4" width="2.7" height="20.2" rx="0.5" fill="url(#cam-chrome)"></rect>
          <rect x="93.6" y="18.2" width="12.8" height="18.4" fill="#14181c"></rect>
          <rect x="97" y="23.6" width="6" height="8.4" rx="0.6" fill="#0b0e11" stroke="#3b444c" stroke-width="0.3"></rect>
          <circle cx="98.6" cy="25.6" r="0.5" fill="#c7a46a"></circle>
          <circle cx="101.4" cy="25.6" r="0.5" fill="#c7a46a"></circle>
          <circle cx="98.6" cy="29.8" r="0.5" fill="#c7a46a"></circle>
          <circle cx="101.4" cy="29.8" r="0.5" fill="#c7a46a"></circle>
          <circle cx="100" cy="27.7" r="0.7" fill="#c7a46a"></circle>
        </g>

        <path d="M38.4 14.9l-1.3-1.9h2.6Z" class="mt-index"></path>
        <TopDial cx={38.4} cy={23.6} r={8.4} marks={COMP} font={1.7} />

        <path d="M61.5 15.4l-1.4-2h2.8Z" class="mt-index"></path>
        <TopDial cx={61.5} cy={29} r={13.4} marks={SHUTTER} turn={dialTurn(read0.k)} font={1.95} at={0.645} />

        <rect x="48" y="44" width="14.6" height="6.2" rx="1" fill="#2a3035"></rect>
        <rect x="48.7" y="44.6" width="13.2" height="5" rx="0.6" fill="url(#cam-lcd)"></rect>
        <text x="61" y="48.35" class="cam-lcd" font-size="3.3" data-lcd>{`F${read0.f}`}</text>
        <rect x="48.7" y="44.6" width="13.2" height="5" rx="0.6" fill="url(#cam-glare)"></rect>

        <g class="cam-release">
          <polygon points={pts(lever)} fill="url(#cam-chrome)" stroke="#4d565e" stroke-width="0.3"></polygon>
          <text x={on.x.toFixed(2)} y={(on.y + 0.65).toFixed(2)} class="cam-eng" font-size="1.7">ON</text>
          <text x={off.x.toFixed(2)} y={(off.y + 0.65).toFixed(2)} class="cam-eng" font-size="1.7">OFF</text>
          <circle cx={REL.x} cy={REL.y + 0.7} r="6.4" fill="#000" opacity="0.3"></circle>
          <circle cx={REL.x} cy={REL.y} r="6.2" fill="#1a1f24"></circle>
          <circle cx={REL.x} cy={REL.y} r="6.2" fill="none" stroke="url(#cam-knurl)" stroke-width="0.7"></circle>
          <g class="cam-button" style={`transform-origin:${REL.x}px ${REL.y}px`}>
            <circle cx={REL.x} cy={REL.y} r="3.9" fill="url(#cam-cap)"></circle>
            <circle cx={REL.x} cy={REL.y} r="2.6" fill="none" stroke="#59626a" stroke-width="0.5" stroke-dasharray="0.35 0.35"></circle>
            <circle cx={REL.x} cy={REL.y} r="1.05" class="cam-socket"></circle>
          </g>
        </g>

        <path d="M138.5 15.7l-1.4-2h2.8Z" class="mt-index"></path>
        <polygon points={pts(isoLever)} fill="url(#cam-chrome)" stroke="#4d565e" stroke-width="0.3"></polygon>
        <TopDial cx={138.5} cy={28.6} r={11.6} marks={ISO} font={1.6} />
        <text x="138.5" y="45.9" class="cam-eng cam-eng-wide" font-size="2.2">ISO</text>
        <text x="157.5" y="45.9" class="cam-eng" font-size="1.75">{coords}</text>

        <rect x="66" y="53.2" width="68" height="2.4" fill="#111518"></rect>
        <rect x="67" y="55.2" width="66" height="3.5" rx="0.6" fill="url(#cam-chrome)"></rect>
        <rect x="67" y="55.2" width="66" height="3.5" rx="0.6" fill="url(#cam-cyl)" opacity="0.6"></rect>
        <circle cx={CX + MOUNT_DOT} cy="56.95" r="0.8" class="cam-mount-dot"></circle>
        <rect x="136" y="53.4" width="4.6" height="4" rx="1.6" fill="url(#cam-chrome)" stroke="#4d565e" stroke-width="0.3"></rect>
      </g>
    </svg>

    <div class="absolute left-0 pr-1 text-right" style={`top:${pct(Y0 + 7, H)};width:${side}`}>
      <p class="m-0 font-mono text-[10px] tracking-[0.08em] text-muted uppercase">Aperture</p>
      <p class="m-0 font-mono text-[16px] leading-6 font-semibold text-ink" data-aperture>f/{read0.f}</p>
      <p class="m-0 font-mono text-[11px] text-muted"><span data-shutter>{read0.shutter}</span><span class="hidden sm:inline"> shutter</span></p>
    </div>
    <div class="absolute right-0 pl-1" style={`top:${pct(Y0 + 7, H)};width:${side}`}>
      <p class="m-0 font-mono text-[10px] tracking-[0.08em] text-muted uppercase">Lens</p>
      <p class="m-0 truncate text-[14px] leading-6 font-bold text-ink sm:text-[15px]" data-lens-name>{lens0}</p>
      <p class="m-0 font-mono text-[11px] text-muted" data-support>{needsSupport(still.kit) ? 'On a tripod' : 'Handheld'}</p>
    </div>
  </div>

  <DayScale sun={sun} start={start} end={end} stops={stops} at={m0} class="mt-2 h-[46px]" />

  <div class="mt-readout mt-2 rounded-2xl border border-line bg-surface-2 px-3.5 pt-2.5 pb-3">
    <p class="m-0 flex h-[22px] items-baseline justify-between gap-3 whitespace-nowrap">
      <span class="font-mono text-[14.5px] font-semibold text-ink tabular-nums sm:text-[15.5px]" data-reading>{readingText(read0)}</span>
      <span class="font-mono text-[11px] text-muted">at ISO 100</span>
    </p>
    <div class="mt-2 grid h-[36px] grid-cols-[minmax(0,1fr)_minmax(0,2.2fr)] gap-3">
      <div class="min-w-0">
        <p class="m-0 font-mono text-[10px] tracking-[0.08em] text-muted uppercase">Light</p>
        <p class="mt-phase m-0 truncate text-[13px] font-semibold" data-phase-label>{PHASE_LABEL[phase0]}</p>
      </div>
      <div class="min-w-0">
        <p class="m-0 font-mono text-[10px] tracking-[0.08em] text-muted uppercase" data-stop-tag>Stop {stop0.n} · now</p>
        <p class="m-0 truncate text-[13px] font-semibold text-ink" data-stop-name>{stop0.name}</p>
      </div>
    </div>
  </div>
</div>

<script>
  import './play';
</script>
