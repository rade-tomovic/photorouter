---
// A camera in profile with three lenses it can mount (wide, standard, tele) and a tripod.
// dayplay.ts sets data-lens and data-tripod; CSS slides the lenses in and out.
interface Props {
  class?: string;
  lens?: 'wide' | 'standard' | 'tele';
  tripod?: boolean;
}
const { class: className = '', lens = 'wide', tripod = false } = Astro.props;
---

<svg viewBox="0 0 150 86" class={`cam ${className}`} data-camera data-lens={lens} data-tripod={tripod ? '' : undefined} aria-hidden="true" focusable="false">
  <g class="cam-tripod">
    <rect x="25" y="58" width="16" height="5" rx="1.5"></rect>
    <path d="M33 63 18 85M33 63v22M33 63l15 22"></path>
  </g>
  <g class="cam-lens" data-kind="tele">
    <rect x="58" y="30" width="58" height="22" rx="3"></rect>
    <rect x="71" y="27" width="7" height="28" rx="1.5"></rect>
    <rect x="72" y="55" width="5" height="4" rx="1"></rect>
    <rect class="cam-grip" x="86" y="29" width="14" height="24" rx="1.5"></rect>
    <rect x="116" y="26" width="16" height="30" rx="2"></rect>
  </g>
  <g class="cam-lens" data-kind="standard">
    <rect x="58" y="31" width="34" height="20" rx="2.5"></rect>
    <rect class="cam-grip" x="63" y="29.5" width="11" height="23" rx="1.5"></rect>
    <rect x="78" y="30" width="7" height="22" rx="1.5"></rect>
    <rect x="92" y="28.5" width="5" height="25" rx="1.2"></rect>
  </g>
  <g class="cam-lens" data-kind="wide">
    <rect x="58" y="31" width="19" height="20" rx="2.5"></rect>
    <rect class="cam-grip" x="61" y="29.5" width="8" height="23" rx="1.5"></rect>
    <path d="M77 31 85 25v32l-8-6Z"></path>
  </g>
  <g class="cam-body">
    <path d="M22 25 27.5 12h14L47 25Z"></path>
    <rect x="15" y="19" width="8" height="6" rx="1.4"></rect>
    <rect x="44" y="19" width="7" height="6" rx="1.4"></rect>
    <rect x="10" y="25" width="44" height="34" rx="5"></rect>
    <rect class="cam-leather" x="10" y="38" width="44" height="12"></rect>
    <rect x="53" y="28" width="6" height="26" rx="1.2"></rect>
    <circle class="cam-dot" cx="48" cy="31" r="2.2"></circle>
    <circle cx="14" cy="29" r="1.6"></circle>
  </g>
</svg>
