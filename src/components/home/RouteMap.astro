---
// World map of the demo trips: a dotted land background and each demo's route
// at its real position, enlarged around its centre so short routes stay
// visible. Positions come from the demo answers at build time.
import { CONTINENT_LABEL, DEMOS, routeOf, statsOf, type Continent } from './demoData';
import { LAND_MASK, MASK_EXTENT } from './worldMask';

const U = 3;
const ENLARGE = 3;
const { west, east, north, south, step } = MASK_EXTENT;
const W = (east - west) * U;
const H = (north - south) * U;
const px = (lng: number) => +((lng - west) * U).toFixed(1);
const py = (lat: number) => +((north - lat) * U).toFixed(1);

const cell = step * U;
const dots = LAND_MASK.map((row, r) => {
  let out = '';
  let last = -1;
  for (let c = 0; c < row.length; c++) {
    if (row[c] !== '#') continue;
    out += last < 0 ? `M${cell / 2 + c * cell} ${cell / 2 + r * cell}h0` : `m${(c - last) * cell} 0h0`;
    last = c;
  }
  return out;
}).join('');

// Where each continent's label sits, in map units, and the end of its leader line.
const LABELS: Record<Continent, { x: number; y: number; anchor: 'start' | 'end'; lx: number; ly: number }> = {
  europe: { x: 455, y: 44, anchor: 'end', lx: 462, ly: 62 },
  'north-america': { x: 40, y: 192, anchor: 'start', lx: 104, ly: 180 },
  'south-america': { x: 410, y: 330, anchor: 'start', lx: 404, ly: 318 },
  africa: { x: 455, y: 152, anchor: 'end', lx: 462, ly: 142 },
  asia: { x: 1040, y: 160, anchor: 'end', lx: 990, ly: 148 },
  oceania: { x: 1040, y: 364, anchor: 'end', lx: 1004, ly: 352 },
};

const routes = DEMOS.map((demo, i) => {
  const { cities } = demo.answer;
  const lat0 = cities.reduce((n, c) => n + c.lat, 0) / cities.length;
  const lng0 = cities.reduce((n, c) => n + c.lng, 0) / cities.length;
  const at = (id: string) => {
    const c = cities.find((x) => x.id === id)!;
    return [px(lng0 + (c.lng - lng0) * ENLARGE), py(lat0 + (c.lat - lat0) * ENLARGE)] as const;
  };
  const { stops, legs } = routeOf(demo.answer);
  const paths = legs.map((l) => {
    const [x1, y1] = at(l.from);
    const [x2, y2] = at(l.to);
    if (l.mode !== 'flight') return { d: `M${x1} ${y1}L${x2} ${y2}`, flight: false };
    const mx = (x1 + x2) / 2 - (y2 - y1) * 0.25;
    const my = (y1 + y2) / 2 + (x2 - x1) * 0.25;
    return { d: `M${x1} ${y1}Q${mx.toFixed(1)} ${my.toFixed(1)} ${x2} ${y2}`, flight: true };
  });
  const stats = statsOf(demo);
  return {
    id: demo.id,
    color: `c-${i % 6}`,
    continent: CONTINENT_LABEL[demo.continent],
    label: demo.label,
    days: stats.days,
    centre: [px(lng0), py(lat0)] as const,
    points: [...new Set(stops)].map(at),
    paths,
    pin: LABELS[demo.continent],
    delay: (0.3 + i * 0.25).toFixed(2),
  };
});

const desc = `${routes.length} demo trips: ${routes.map((r) => `${r.label} (${r.continent})`).join(', ')}.`;
---

<svg viewBox={`0 0 ${W} ${H}`} class="block h-auto w-full" role="img" aria-labelledby="world-map-title world-map-desc">
  <title id="world-map-title">World map of the demo trips</title>
  <desc id="world-map-desc">{desc}</desc>

  <path d={dots} class="wm-dots" fill="none" stroke-width="3.2" stroke-linecap="round"></path>

  {
    routes.map((r) => (
      <g class={`${r.color} wm-route`} style={`--d:${r.delay}s`}>
        <path
          d={`M${r.centre[0]} ${r.centre[1]}L${r.pin.lx} ${r.pin.ly}`}
          class="max-sm:hidden"
          fill="none"
          stroke="var(--muted)"
          stroke-width="0.8"
          stroke-dasharray="2 2.5"
        />
        {r.paths.map((p) => (
          <path
            d={p.d}
            fill="none"
            stroke="var(--c)"
            stroke-width="2.6"
            stroke-linecap="round"
            stroke-dasharray={p.flight ? '1 4.5' : undefined}
          />
        ))}
        <circle cx={r.points[0]![0]} cy={r.points[0]![1]} r="4" fill="none" stroke="var(--c)" stroke-width="1.6" class="wm-pulse" />
        {r.points.map(([x, y]) => (
          <circle cx={x} cy={y} r="3.2" fill="var(--surface)" stroke="var(--c)" stroke-width="2" />
        ))}
        <g class="max-sm:hidden" text-anchor={r.pin.anchor}>
          <text x={r.pin.x} y={r.pin.y} class="halo font-mono" font-size="10.5" letter-spacing="1.2" fill="var(--muted)">
            {`${r.continent.toUpperCase()} · ${r.days} DAYS`}
          </text>
          <text x={r.pin.x} y={r.pin.y + 17} class="halo" font-size="14" font-weight="700" fill="var(--ink)">
            {r.label}
          </text>
        </g>
      </g>
    ))
  }
</svg>

<ul class="m-0 mt-3 grid list-none grid-cols-1 gap-x-4 gap-y-2 p-0 min-[400px]:grid-cols-2 sm:hidden" aria-hidden="true">
  {
    routes.map((r) => (
      <li class={`${r.color} flex items-start gap-2 text-[13px] leading-snug`}>
        <span class="mt-1 size-2.5 shrink-0 rounded-full bg-(--c)" />
        <span>
          <span class="block font-mono text-[10.5px] tracking-[0.08em] text-muted uppercase">{r.continent}</span>
          <span class="font-semibold">{r.label}</span>
        </span>
      </li>
    ))
  }
</ul>
