---
import SectionHead from './SectionHead.astro';
import { demoFor, importReport } from './demoData';

const checks = [
  {
    title: 'Every date, in order',
    text: 'Each trip date has one entry, even a day with no slots, and no date outside the trip appears.',
  },
  {
    title: 'A consistent chain of cities',
    text: "A day that changes city needs travel from the previous night's city. A day without travel stays put.",
  },
  {
    title: 'Spots near their city',
    text: 'Every spot sits within 150 km of the city it is filed under, which catches wrong coordinates.',
  },
  {
    title: 'Light fits the slot',
    text: 'Dawn spots go in early slots, golden and blue hour spots at sunset, night spots after dark.',
  },
  {
    title: 'Slots and stops per day',
    text: 'Each day uses only the slots it allows and stays within its stop limit, both set by your pace and working hours.',
  },
  { title: 'Tripod', text: 'A spot that needs a tripod is rejected when the kit has neither a tripod nor a clamp.' },
  {
    title: 'Crowds and walking',
    text: 'The busiest spots are rejected when you avoid crowds, real hikes when you ask for easy walking.',
  },
  {
    title: 'Must-see and skip',
    text: 'Places on the skip list are never planned. Every must-see is planned or listed as left out with a reason.',
  },
];

const demo = demoFor('europe');
const report = importReport(demo);
const blocked = report.some((l) => l.level === 'error');
---

<section id="validation" aria-labelledby="validation-title" class="scroll-mt-4 border-b border-line bg-surface-2/40">
  <div class="mx-auto grid max-w-6xl gap-12 px-4 py-16 sm:px-6 sm:py-20 lg:grid-cols-[1.25fr_1fr] lg:items-start">
    <div class="min-w-0">
      <SectionHead id="validation-title" kicker="Validation" title="Every answer is checked before it loads">
        <p>
          An AI can return a plan that reads well and still breaks the trip. PhotoRouter validates the pasted JSON against the
          schema and against the same rules the prompt describes. Errors block the import and name the day, slot or spot to
          fix. Warnings are shown, and the plan still loads.
        </p>
      </SectionHead>
      <ul class="mt-10 grid list-none gap-x-8 gap-y-6 p-0 sm:grid-cols-2">
        {
          checks.map((c) => (
            <li class="flex gap-3">
              <svg viewBox="0 0 20 20" class="mt-0.5 size-5 shrink-0 text-accent" aria-hidden="true" focusable="false">
                <circle cx="10" cy="10" r="9" fill="none" stroke="currentColor" stroke-width="1.6" />
                <path d="m6 10.2 2.6 2.6L14 7.4" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
              <div>
                <h3 class="m-0 text-[15px] font-bold">{c.title}</h3>
                <p class="mt-1 mb-0 text-[14.5px] leading-relaxed text-muted">{c.text}</p>
              </div>
            </li>
          ))
        }
      </ul>
    </div>

    <figure class="m-0 min-w-0 lg:sticky lg:top-6">
      <div class="rounded-[22px] border border-line bg-surface p-4 shadow-card sm:p-5">
        <div class="flex items-center justify-between gap-3 border-b border-line pb-3">
          <p class="m-0 font-mono text-[11px] tracking-[0.08em] text-muted uppercase">Import report</p>
          <span class="inline-flex h-6 items-center rounded-full border border-line bg-surface-2 px-2.5 text-xs font-semibold">
            {blocked ? 'Blocked' : 'Imported'}
          </span>
        </div>
        <ul class="m-0 mt-4 flex list-none flex-col gap-3 p-0 text-[13.5px] leading-snug">
          {
            report.map((line) => (
              <li class={`${line.level === 'error' ? 'c-0' : 'lt-golden'} rounded-xl border border-line bg-surface-2 p-3`}>
                <p class="m-0 flex items-center gap-1.5 font-mono text-[10.5px] font-semibold tracking-[0.08em] uppercase">
                  <span class="size-2 rounded-full bg-(--c)" aria-hidden="true" />
                  {line.level}
                </p>
                <p class="mt-1 mb-0 break-words">{line.text}</p>
              </li>
            ))
          }
        </ul>
      </div>
      <figcaption class="mt-3 px-1 text-[13px] text-muted">
        Importer messages for edited copies of the {demo.label} demo: a travel leg removed, a spot filed under the wrong
        city, an evening spot put in a morning slot and a must-see left out.
      </figcaption>
    </figure>
  </div>
</section>
