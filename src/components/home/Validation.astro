---
import SectionHead from './SectionHead.astro';
import { demoFor, importReport } from './demoData';

const checks = [
  {
    title: 'Every day covered',
    text: 'Each day of your trip is in the plan, in order and with no gaps. A plan for other dates still opens as its own trip, and the checks below show as notes.',
  },
  {
    title: 'A way to get there',
    text: 'Whenever the plan moves to a new city, it includes the train, flight, ferry, bus or drive to get there.',
  },
  {
    title: 'Spots where they should be',
    text: 'Every spot is close to the city it belongs to, which catches places put in the wrong town.',
  },
  {
    title: 'The right time of day',
    text: 'Sunrise spots are planned for the morning, sunset spots for the evening and night spots after dark.',
  },
  {
    title: 'Days you can manage',
    text: 'No day has more stops than your pace allows, and work days keep shooting to your free hours.',
  },
  { title: 'Your gear', text: 'Spots that need a tripod are only planned when you bring a tripod or a clamp.' },
  {
    title: 'Crowds and walking',
    text: 'The busiest places stay out when you avoid crowds, and long hikes stay out when you want easy walking.',
  },
  {
    title: 'Must-see and skip',
    text: 'Places you skip never appear. Every must-see is planned, or listed with the reason it was left out.',
  },
];

const demo = demoFor('europe');
const report = importReport(demo);
const blocked = report.some((l) => l.level === 'error');
---

<section id="validation" aria-labelledby="validation-title" class="scroll-mt-4 border-b border-line bg-surface-2/40">
  <div class="mx-auto grid max-w-6xl gap-12 px-4 py-16 sm:px-6 sm:py-20 lg:grid-cols-[1.25fr_1fr] lg:items-start">
    <div class="min-w-0">
      <SectionHead id="validation-title" kicker="Checked for you" title="Every plan is checked before it reaches the map">
        <p>
          An AI assistant can write a plan that reads well and still gets things wrong. PhotoRouter checks every reply against
          your trip. A real problem names the day and spot to fix, so you can ask the assistant to correct it. Smaller notes
          are shown next to the plan, which still opens.
        </p>
      </SectionHead>
      <ul class="mt-10 grid list-none gap-x-8 gap-y-6 p-0 sm:grid-cols-2">
        {
          checks.map((c) => (
            <li class="flex gap-3">
              <svg viewBox="0 0 20 20" class="mt-0.5 size-5 shrink-0 text-accent" aria-hidden="true" focusable="false">
                <circle cx="10" cy="10" r="9" fill="none" stroke="currentColor" stroke-width="1.6" />
                <path d="m6 10.2 2.6 2.6L14 7.4" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
              <div>
                <h3 class="m-0 text-[15px] font-bold">{c.title}</h3>
                <p class="mt-1 mb-0 text-[14.5px] leading-relaxed text-muted">{c.text}</p>
              </div>
            </li>
          ))
        }
      </ul>
    </div>

    <figure class="m-0 min-w-0 lg:sticky lg:top-6">
      <div class="rounded-[22px] border border-line bg-surface p-4 shadow-card sm:p-5">
        <div class="flex items-center justify-between gap-3 border-b border-line pb-3">
          <p class="m-0 font-mono text-[11px] tracking-[0.08em] text-muted uppercase">What PhotoRouter found</p>
          <span class="inline-flex h-6 items-center rounded-full border border-line bg-surface-2 px-2.5 text-xs font-semibold">
            {blocked ? 'Needs fixing' : 'Plan loaded'}
          </span>
        </div>
        <ul class="m-0 mt-4 flex list-none flex-col gap-3 p-0 text-[13.5px] leading-snug">
          {
            report.map((line) => (
              <li class={`${line.level === 'error' ? 'c-0' : 'lt-golden'} rounded-xl border border-line bg-surface-2 p-3`}>
                <p class="m-0 flex items-center gap-1.5 font-mono text-[10.5px] font-semibold tracking-[0.08em] uppercase">
                  <span class="size-2 rounded-full bg-(--c)" aria-hidden="true" />
                  {line.level === 'error' ? 'Problem' : 'Note'}
                </p>
                <p class="mt-1 mb-0 break-words">{line.text}</p>
              </li>
            ))
          }
        </ul>
      </div>
      <figcaption class="mt-3 px-1 text-[13px] text-muted">
        Messages for a broken copy of the {demo.label} example: a train left out, a spot put in the wrong city, a sunset
        spot planned for the morning and a must-see left out.
      </figcaption>
    </figure>
  </div>
</section>
