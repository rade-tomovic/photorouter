---
import RouteMap from './RouteMap.astro';
import LightDay from './LightDay.astro';
import { APP_PATH } from './links';
import { DEMOS, HERO_DAY, countWord, daySheet, demoFor } from './demoData';

const steps = ['Describe your trip', 'Ask your AI assistant', 'Follow the route'];
const demo = demoFor(HERO_DAY.continent);
const day = HERO_DAY.index;
const sheet = daySheet(demo, day);
---

<section aria-labelledby="hero-title" class="grain relative overflow-hidden border-b border-line">
  <div class="mx-auto max-w-6xl px-4 py-12 sm:px-6 sm:py-16 lg:py-20">
    <div class="grid gap-10 lg:grid-cols-[1.15fr_1fr] lg:items-center lg:gap-12">
      <div class="min-w-0">
        <p class="t-accent m-0 font-mono text-[11.5px] tracking-[0.1em] uppercase">For travel photographers</p>
        <h1
          id="hero-title"
          class="mt-4 mb-0 font-display text-[clamp(46px,9vw,92px)] leading-[0.92] font-extrabold tracking-[0.01em] text-balance uppercase"
        >
          <span class="block">Right place.</span>
          <span class="t-accent block">Right light.</span>
        </h1>
        <p class="mt-6 mb-0 max-w-[34rem] text-[17px] leading-relaxed text-muted sm:text-lg">
          Plan a photo trip anywhere: where to shoot, when the light is best and what to pack, for every day of your trip, on a
          3D map.
        </p>
        <ol class="mt-6 flex list-none flex-wrap items-center gap-x-3 gap-y-2 p-0 text-sm font-semibold" aria-label="How it works">
          {
            steps.map((step, i) => (
              <li class="flex items-center gap-3">
                <span class="flex items-center gap-2">
                  <span class="grid size-6 place-items-center rounded-full border border-line bg-surface-2 font-mono text-[11px] text-accent">
                    {i + 1}
                  </span>
                  {step}
                </span>
                {i < steps.length - 1 && (
                  <span class="text-muted" aria-hidden="true">→</span>
                )}
              </li>
            ))
          }
        </ol>
        <div class="mt-8 flex flex-wrap items-center gap-3">
          <a
            href={APP_PATH}
            class="inline-flex h-12 items-center gap-2 rounded-full bg-accent px-6 text-[15px] font-semibold text-accent-ink no-underline shadow-card hover:brightness-110"
          >
            Plan my trip
            <svg viewBox="0 0 16 16" class="size-4" aria-hidden="true" focusable="false">
              <path d="M3 8h9M8.5 4 12.5 8l-4 4" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"></path>
            </svg>
          </a>
          <a
            href={`${APP_PATH}?demo=${demo.id}`}
            class="inline-flex h-12 items-center gap-2 rounded-full border border-line bg-surface px-5 text-[15px] font-semibold text-ink no-underline hover:border-muted"
          >
            <svg viewBox="0 0 16 16" class="size-3.5" aria-hidden="true" focusable="false">
              <path d="M5 3.5v9l7.5-4.5Z" fill="currentColor"></path>
            </svg>
            Watch {demo.label}
          </a>
        </div>
        <p class="mt-4 mb-0 text-[13px] text-muted">Free · No sign-up · Any destination</p>
      </div>

      <figure class="m-0 min-w-0">
        <LightDay demo={demo} index={day} />
        <figcaption class="mt-3 px-1 text-[13px] text-muted">
          A day of the {demo.label} example: the sun over {sheet.city} on {sheet.longDate}, each stop at its planned time.
          Scroll down to follow the day.
        </figcaption>
      </figure>
    </div>

    <figure class="m-0 mt-10 min-w-0 sm:mt-12">
      <div class="rounded-[22px] border border-line bg-surface p-3 shadow-card sm:p-5">
        <RouteMap />
      </div>
      <figcaption class="mt-3 px-1 text-[13px] text-muted">
        The {countWord(DEMOS.length).toLowerCase()} example trips, each drawn three times larger than life so the route is visible.
        Dotted lines are flights between cities.
      </figcaption>
    </figure>
  </div>
</section>
