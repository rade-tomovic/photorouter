---
import RouteMap from './RouteMap.astro';
import { APP_PATH, SCHEMA_PATH } from './links';

const lights = [
  { id: 'dawn', label: 'Dawn' },
  { id: 'day', label: 'Daylight' },
  { id: 'golden', label: 'Golden or blue hour' },
  { id: 'night', label: 'Night' },
];
const facts = ['15-day demo trip', '3 cities', '42 photo spots', 'MIT licence'];
---

<section aria-labelledby="hero-title" class="grain relative overflow-hidden border-b border-line">
  <div class="mx-auto grid max-w-6xl items-center gap-10 px-4 py-12 sm:px-6 sm:py-16 lg:grid-cols-[1.05fr_1fr] lg:gap-12 lg:py-20">
    <div class="min-w-0">
      <p class="t-accent m-0 font-mono text-[11.5px] tracking-[0.1em] uppercase">Photo trip planner · runs in your browser</p>
      <h1
        id="hero-title"
        class="mt-4 mb-0 font-display text-[clamp(46px,9vw,92px)] leading-[0.92] font-extrabold tracking-[0.01em] text-balance uppercase"
      >
        Plan a photo trip with your own AI
      </h1>
      <p class="mt-6 mb-0 max-w-[36rem] text-[17px] leading-relaxed text-muted sm:text-lg">
        PhotoRouter turns your gear, style and pace into a prompt for any AI assistant. Paste the JSON plan it returns, and
        PhotoRouter checks it against your trip and plays the route on a 3D map. No account, no backend, nothing to install.
      </p>
      <div class="mt-8 flex flex-wrap items-center gap-3">
        <a
          href={APP_PATH}
          class="inline-flex h-12 items-center gap-2 rounded-full bg-accent px-6 text-[15px] font-semibold text-accent-ink no-underline shadow-card hover:brightness-110"
        >
          Open the planner
          <svg viewBox="0 0 16 16" class="size-4" aria-hidden="true" focusable="false">
            <path d="M3 8h9M8.5 4 12.5 8l-4 4" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"></path>
          </svg>
        </a>
        <a
          href={SCHEMA_PATH}
          class="inline-flex h-12 items-center gap-2 rounded-full border border-line bg-surface px-5 text-[15px] font-semibold text-ink no-underline hover:border-muted"
        >
          View the JSON Schema
          <span class="hidden font-mono text-xs font-normal text-muted sm:inline">/plan.schema.json</span>
        </a>
      </div>
      <ul class="mt-8 flex list-none flex-wrap gap-2 p-0" aria-label="At a glance">
        {
          facts.map((f) => (
            <li class="inline-flex h-7 items-center rounded-full border border-line bg-surface-2 px-3 font-mono text-[11px] tracking-[0.06em] text-muted uppercase">
              {f}
            </li>
          ))
        }
      </ul>
    </div>

    <figure class="m-0 min-w-0">
      <div class="rounded-[22px] border border-line bg-surface p-3 shadow-card sm:p-4">
        <RouteMap />
        <div class="mt-2 flex flex-wrap items-center gap-x-4 gap-y-2 border-t border-line px-1 pt-3">
          <span class="font-mono text-[10.5px] tracking-[0.08em] text-muted uppercase">Light</span>
          {
            lights.map((l) => (
              <span class={`lt-${l.id} inline-flex items-center gap-1.5 text-xs font-semibold text-ink`}>
                <span class="size-2.5 rounded-full bg-(--c)" aria-hidden="true" />
                {l.label}
              </span>
            ))
          }
        </div>
      </div>
      <figcaption class="mt-3 px-1 text-[13px] text-muted">
        The demo trip, 16 to 30 November 2026. City clusters are enlarged so each spot stays visible.
      </figcaption>
    </figure>
  </div>
</section>
