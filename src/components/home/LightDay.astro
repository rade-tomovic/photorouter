---
import { daySheet, type Demo } from './demoData';
import { hhmm, sunDay, tzOffset } from '@/photorouter/lib/sun';

interface Props {
  demo: Demo;
  index: number;
}
const { demo, index } = Astro.props;
const sheet = daySheet(demo, index);
const sun = sunDay(sheet.date, sheet.ll[1], sheet.ll[0], tzOffset(sheet.date, sheet.tz));

const W = 340;
const horizon = 118;
const peak = 26;
const minutes = (t: string) => t.match(/\d\d:\d\d/g)?.map((s) => +s.slice(0, 2) * 60 + +s.slice(3)) ?? [];
const times = sheet.stops.map((s) => {
  const [a = 0, b = a] = minutes(s.window);
  return (a + b) / 2;
});
const from = Math.min(sun.dawnBlue, ...times) - 30;
const to = Math.max(sun.blueEnd, ...times) + 30;
const x = (m: number) => 14 + ((m - from) / (to - from)) * (W - 28);
const y = (m: number) => {
  const h = Math.sin((Math.PI * (m - sun.sunrise)) / (sun.sunset - sun.sunrise));
  return Math.min(horizon + 22, horizon - (horizon - peak) * h);
};
const arc = (a: number, b: number) =>
  Array.from({ length: 41 }, (_, i) => a + ((b - a) * i) / 40)
    .map((m, i) => `${i ? 'L' : 'M'}${x(m).toFixed(1)} ${y(m).toFixed(1)}`)
    .join(' ');
const band = (a: number, b: number) => ({ x: x(a), w: x(b) - x(a) });

const stops = sheet.stops.map((s, i) => ({ ...s, n: i + 1, cx: x(times[i]!), cy: y(times[i]!) }));
---

<div class="rounded-[22px] border border-line bg-surface p-4 shadow-card sm:p-5">
  <div class="flex items-center justify-between gap-2">
    <p class="m-0 font-mono text-[11px] tracking-[0.08em] text-muted uppercase">Day {sheet.number} · {sheet.label}</p>
    <span class={`c-${sheet.cityColor} inline-flex h-6 items-center gap-1.5 rounded-full border border-line px-2.5 text-xs font-semibold`}>
      <span class="size-2 rounded-full bg-(--c)" aria-hidden="true"></span>{sheet.city}
    </span>
  </div>

  <svg viewBox={`0 0 ${W} 150`} class="mt-3 block h-auto w-full" aria-hidden="true" focusable="false">
    <defs>
      <linearGradient id="light-glow" x1="0" x2="0" y1="0" y2="1">
        <stop offset="0" stop-color="var(--golden)" stop-opacity="0"></stop>
        <stop offset="1" stop-color="var(--golden)" stop-opacity="0.32"></stop>
      </linearGradient>
    </defs>
    {
      [band(sun.dawnBlue, sun.goldenAmEnd), band(sun.goldenPmStart, sun.blueEnd)].map((b) => (
        <rect x={b.x} y={peak} width={b.w} height={horizon - peak} fill="url(#light-glow)" />
      ))
    }
    <line x1="8" x2={W - 8} y1={horizon} y2={horizon} stroke="var(--line)" stroke-width="1.5"></line>
    <path d={arc(sun.sunrise - 70, sun.sunrise)} fill="none" stroke="var(--line)" stroke-width="1.5" stroke-dasharray="3 4"></path>
    <path d={arc(sun.sunset, sun.sunset + 70)} fill="none" stroke="var(--line)" stroke-width="1.5" stroke-dasharray="3 4"></path>
    <path d={arc(sun.sunrise, sun.sunset)} fill="none" stroke="var(--muted)" stroke-width="1.5" opacity="0.6"></path>
    {
      stops.map((s) => (
        <g class={`lt-${s.light}`}>
          <circle cx={s.cx} cy={s.cy} r="13" fill="var(--c)" opacity="0.18" />
          <circle cx={s.cx} cy={s.cy} r="8.5" fill="var(--c)" />
          <text x={s.cx} y={s.cy + 3.5} text-anchor="middle" font-size="10" font-weight="700" fill="var(--surface)">{s.n}</text>
        </g>
      ))
    }
    <text x={x(sun.sunrise)} y={horizon + 18} text-anchor="middle" class="font-mono" font-size="9.5" fill="var(--muted)">↑ {hhmm(sun.sunrise)}</text>
    <text x={x(sun.sunset)} y={horizon + 18} text-anchor="middle" class="font-mono" font-size="9.5" fill="var(--muted)">↓ {hhmm(sun.sunset)}</text>
  </svg>

  <ol class="m-0 mt-2 flex list-none flex-col gap-2.5 p-0">
    {
      stops.map((s) => (
        <li class={`lt-${s.light} flex items-center gap-3`}>
          <span class="grid size-6 shrink-0 place-items-center rounded-full bg-(--c) text-[11px] font-bold text-surface">{s.n}</span>
          <span class="min-w-0 flex-1 truncate font-semibold">{s.name}</span>
          <span class="shrink-0 font-mono text-xs text-muted">{s.window.slice(0, 5)}</span>
        </li>
      ))
    }
  </ol>
</div>
