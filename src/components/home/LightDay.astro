---
// One planned day drawn as the sun's path, with each stop on the arc at its planned
// time. Without JavaScript it is a still drawing; dayplay.ts plays the sun across it.
import { lightDay, type Demo } from './demoData';
import Camera from './Camera.astro';
import DayRail from './DayRail.astro';
import { elevation, lensKind, needsSupport, phases } from './daylight';
import { hhmm } from '@/photorouter/lib/sun';

interface Props {
  demo: Demo;
  index: number;
}
const { demo, index } = Astro.props;
const { sheet, sun, stops, start, end, play } = lightDay(demo, index);

const geo = { W: 340, horizon: 118, peak: 26 };
const x = (m: number) => 14 + ((m - start) / (end - start)) * (geo.W - 28);
const y = (m: number) => geo.horizon - (geo.horizon - geo.peak) * elevation(m, sun);
const arc = (a: number, b: number) =>
  Array.from({ length: 41 }, (_, i) => a + ((b - a) * i) / 40)
    .map((m, i) => `${i ? 'L' : 'M'}${x(m).toFixed(1)} ${y(m).toFixed(1)}`)
    .join(' ');
const inset = `${((14 / geo.W) * 100).toFixed(3)}%`;
const at = (m: number) => `left:${((x(m) / geo.W) * 100).toFixed(2)}%`;
const glows = phases(sun, start, end).filter((p) => p.phase === 'golden' || p.phase === 'blue');
const first = stops[0]!;
const firstLens = first.kit.find((k) => lensKind(k));
---

<div class="lightday rounded-[22px] border border-line bg-surface p-4 shadow-card sm:p-5" data-lightday data-day={JSON.stringify(play)}>
  <div class="flex items-center justify-between gap-2">
    <p class="m-0 font-mono text-[11px] tracking-[0.08em] text-muted uppercase">
      Day {sheet.number} · {sheet.label}<span class="ld-clock tabular-nums" data-clock></span>
    </p>
    <span class={`c-${sheet.cityColor} inline-flex h-6 items-center gap-1.5 rounded-full border border-line px-2.5 text-xs font-semibold`}>
      <span class="size-2 rounded-full bg-(--c)" aria-hidden="true"></span>{sheet.city}
    </span>
  </div>

  <svg viewBox={`0 0 ${geo.W} ${geo.horizon}`} class="mt-3 block h-auto w-full overflow-visible" data-geo={JSON.stringify(geo)} aria-hidden="true" focusable="false">
    <defs>
      <linearGradient id="ld-golden" x1="0" x2="0" y1="0" y2="1">
        <stop offset="0" stop-color="var(--golden)" stop-opacity="0"></stop>
        <stop offset="1" stop-color="var(--golden)" stop-opacity="0.32"></stop>
      </linearGradient>
      <linearGradient id="ld-blue" x1="0" x2="0" y1="0" y2="1">
        <stop offset="0" stop-color="var(--night)" stop-opacity="0"></stop>
        <stop offset="1" stop-color="var(--night)" stop-opacity="0.3"></stop>
      </linearGradient>
      <radialGradient id="ld-sun">
        <stop offset="0" stop-color="var(--sun-c)" stop-opacity="0.55"></stop>
        <stop offset="1" stop-color="var(--sun-c)" stop-opacity="0"></stop>
      </radialGradient>
    </defs>
    <rect class="ld-sky" x="0" y="0" width={geo.W} height={geo.horizon} rx="10"></rect>
    {
      glows.map((g) => (
        <rect x={x(g.from)} y={geo.peak} width={x(g.to) - x(g.from)} height={geo.horizon - geo.peak} fill={`url(#ld-${g.phase})`} />
      ))
    }
    <path d={arc(start, sun.sunrise)} fill="none" stroke="var(--line)" stroke-width="1.5" stroke-dasharray="3 4"></path>
    <path d={arc(sun.sunset, end)} fill="none" stroke="var(--line)" stroke-width="1.5" stroke-dasharray="3 4"></path>
    <path d={arc(sun.sunrise, sun.sunset)} fill="none" stroke="var(--muted)" stroke-width="1.5" opacity="0.6"></path>
    <path class="ld-trail" data-trail d="" fill="none" stroke-width="2.5" stroke-linecap="round"></path>
    {
      stops.map((s) => (
        <g class={`lt-${s.light} ld-stop`} data-stop={s.n}>
          <circle class="ld-ping" cx={x(s.t)} cy={y(s.t)} r="13" fill="var(--c)" opacity="0.18" />
          <circle cx={x(s.t)} cy={y(s.t)} r="8.5" fill="var(--c)" />
          <text x={x(s.t)} y={y(s.t) + 3.5} text-anchor="middle" font-size="10" font-weight="700" fill="var(--surface)">{s.n}</text>
        </g>
      ))
    }
    <g class="ld-sun" data-sun>
      <circle r="18" fill="url(#ld-sun)"></circle>
      <circle r="6" fill="var(--sun-c)"></circle>
    </g>
  </svg>
  <div class="relative -mt-1" aria-hidden="true">
    <DayRail sun={sun} start={start} end={end} class="h-2" style={`margin:0 ${inset}`} />
    <div class="relative h-5 font-mono text-[10.5px] text-muted">
      <span class="absolute top-1.5 -translate-x-1/2 whitespace-nowrap" style={at(sun.sunrise)}>↑ {hhmm(sun.sunrise)}</span>
      <span class="absolute top-1.5 -translate-x-1/2 whitespace-nowrap" style={at(sun.sunset)}>↓ {hhmm(sun.sunset)}</span>
    </div>
  </div>

  <ol class="m-0 mt-2 flex list-none flex-col gap-1.5 p-0">
    {
      stops.map((s) => (
        <li class={`lt-${s.light} ld-row`} data-row={s.n}>
          <div class="flex items-center gap-3">
            <span class="grid size-6 shrink-0 place-items-center rounded-full bg-(--c) text-[11px] font-bold text-surface">{s.n}</span>
            <span class="min-w-0 flex-1 truncate font-semibold">{s.name}</span>
            <span class="shrink-0 font-mono text-xs text-muted">{hhmm(s.from)}</span>
          </div>
        </li>
      ))
    }
  </ol>

  <div class="mt-4 flex h-[78px] items-center gap-3 rounded-2xl border border-line bg-surface-2 px-3">
    <Camera class="h-[64px] w-auto shrink-0" lens={(firstLens && lensKind(firstLens)) || 'wide'} tripod={needsSupport(first.kit)} />
    <div class="min-w-0 flex-1">
      <p class="m-0 truncate font-mono text-[10.5px] tracking-[0.08em] text-muted uppercase" data-bag-title>In the bag · {first.name}</p>
      <p class="ld-swap m-0 truncate text-[15px] font-bold" data-bag-lens>{firstLens}</p>
      <p class="m-0 truncate font-mono text-[11px] text-muted" data-bag-kit>{first.kit.join(' · ')}</p>
    </div>
  </div>
</div>
