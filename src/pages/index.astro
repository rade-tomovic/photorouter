---
import Base from '@/layouts/Base.astro';
import Header from '@/components/home/Header.astro';
import Hero from '@/components/home/Hero.astro';
import HowItWorks from '@/components/home/HowItWorks.astro';
import Validation from '@/components/home/Validation.astro';
import MapPlayback from '@/components/home/MapPlayback.astro';
import DemoTrips from '@/components/home/DemoTrips.astro';
import Privacy from '@/components/home/Privacy.astro';
import Cta from '@/components/home/Cta.astro';
import Footer from '@/components/home/Footer.astro';
import { DEMOS, countWord } from '@/components/home/demoData';
import '@/styles/home.css';

const description = `Plan a photo trip anywhere: where to shoot, at what time of day and what to pack, played as a route on a 3D map. ${countWord(DEMOS.length)} example trips, free, no sign-up.`;
---

<Base
  title="PhotoRouter: plan a photo trip anywhere"
  description={description}
>
  <div class="home min-h-full overflow-x-clip">
    <a
      href="#main"
      class="sr-only rounded-full bg-accent px-4 py-2 font-semibold text-accent-ink focus:not-sr-only focus:fixed focus:px-4 focus:py-2 focus:top-3 focus:left-3 focus:z-50"
    >
      Skip to content
    </a>
    <Header />
    <main id="main" tabindex="-1" class="outline-none">
      <Hero />
      <HowItWorks />
      <Validation />
      <MapPlayback />
      <DemoTrips />
      <Privacy />
      <Cta />
    </main>
    <Footer />
  </div>
  <script>
    import '@/components/home/dayplay';
  </script>
</Base>
