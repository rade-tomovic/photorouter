/*
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  X-Frame-Options: DENY
  Content-Security-Policy: default-src 'self'; script-src 'self'; worker-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://tiles.openfreemap.org https://tiles.mapterhorn.com; font-src 'self' data:; connect-src 'self' https://tiles.openfreemap.org https://tiles.mapterhorn.com; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; upgrade-insecure-requests

# A worker loaded from a URL is governed by the CSP on its own response, not
# the page's, and it is the MapLibre worker that fetches vector tiles.
/_astro/maplibre-gl-worker.*
  ! Content-Security-Policy
  Content-Security-Policy: default-src 'none'; script-src 'self'; connect-src 'self' https://tiles.openfreemap.org https://tiles.mapterhorn.com; img-src 'self' data: blob:

/_astro/*
  Cache-Control: public, max-age=31536000, immutable
